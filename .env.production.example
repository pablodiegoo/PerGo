# =============================================================================
# PerGo — Production Environment Variables (.env)
# =============================================================================
# Copy this file to .env and adjust the values before starting:
#   cp .env.production.example .env
#   chmod 600 .env
# =============================================================================

# Domain & TLS Configuration (Traefik + Let's Encrypt)
# Must be a valid FQDN pointing to this server's public IP
DOMAIN=api.pergo.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# PostgreSQL Configuration
POSTGRES_USER=pergo
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=pergo

# PerGo Application Configuration
PERGO_ENV=production
PERGO_SERVER_PORT=8080

# Administrative Credentials
# Password to access the /admin web console
PERGO_ADMIN_PASSWORD=change_this_to_a_secure_admin_password

# Cryptographic Keys
# Session secret used for signing operator cookies (32+ chars)
PERGO_SESSION_SECRET=change_this_to_a_random_32_character_string_here

# Key Encryption Key (KEK) for encrypting WhatsApp & channel credentials at rest.
# MUST be exactly 32 bytes encoded in Base64 (generate with: openssl rand -base64 32).
# WARNING: Do NOT lose or alter this key after setup, or all saved channel sessions will be lost.
PERGO_KEK_BASE64=

# Optional: S3 / MinIO Object Storage for Inbound/Outbound Media
# If left blank, media is stored in local volume (/app/data/media)
PERGO_S3_ENDPOINT=
PERGO_S3_BUCKET=
PERGO_S3_ACCESS_KEY=
PERGO_S3_SECRET_KEY=
PERGO_S3_REGION=us-east-1
PERGO_S3_USE_PATH_STYLE=false

# Optional: Data Governance & LGPD Purge (in days)
MEDIA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
