package layout

import (
	"context"
	"fmt"
	"strings"

	"github.com/pablojhp.pergo/internal/api/middleware"
	"github.com/pablojhp.pergo/internal/i18n"
	"github.com/pablojhp.pergo/internal/repository"
)

func getActivePath(ctx context.Context) string {
	return middleware.ActivePathFrom(ctx)
}

func getActiveWorkspace(ctx context.Context) *repository.Workspace {
	return middleware.ActiveWorkspaceFrom(ctx)
}

func getWorkspacesList(ctx context.Context) []repository.Workspace {
	if val, ok := ctx.Value("workspaces_list").([]repository.Workspace); ok {
		return val
	}
	return nil
}

func isSettingsActive(activePath string) bool {
	if strings.Contains(activePath, "/campaigns") {
		return false
	}
	prefixes := []string{
		"/admin/connections",
		"/admin/devices",
		"/admin/logs",
		"/admin/audit",
		"/admin/workspace",
		"/admin/workspaces",
		"/admin/webhooks",
		"/admin/telemetry",
		"/admin/integrations",
		"/admin/developers",
	}
	for _, p := range prefixes {
		if strings.HasPrefix(activePath, p) {
			return true
		}
	}
	return false
}

func isSubmenuActive(activePath, target string) bool {
	if target == "/admin/developers" || strings.Contains(target, "/developers") {
		return strings.HasPrefix(activePath, "/admin/developers")
	}
	if strings.Contains(target, "/integrations/chatwoot") {
		return strings.Contains(activePath, "/integrations/chatwoot")
	}
	if strings.Contains(target, "/integrations/typebot") {
		return strings.Contains(activePath, "/integrations/typebot")
	}
	if strings.Contains(target, "/integrations/headless") || target == "/admin/integrations" {
		return strings.Contains(activePath, "/integrations/headless") ||
			(strings.Contains(activePath, "/integrations") && !strings.Contains(activePath, "/chatwoot") && !strings.Contains(activePath, "/typebot"))
	}
	if target == "/admin/connections" {
		return strings.HasPrefix(activePath, "/admin/connections") || strings.HasPrefix(activePath, "/admin/devices")
	}
	if target == "/admin/logs" {
		return strings.HasPrefix(activePath, "/admin/logs") || strings.HasPrefix(activePath, "/admin/audit")
	}
	if target == "/admin/workspace" {
		return (strings.HasPrefix(activePath, "/admin/workspace") || strings.HasPrefix(activePath, "/admin/workspaces")) &&
			!strings.Contains(activePath, "/webhooks") &&
			!strings.Contains(activePath, "/campaigns") &&
			!strings.Contains(activePath, "/integrations") &&
			!strings.Contains(activePath, "/developers") &&
			!strings.Contains(activePath, "/templates") &&
			!strings.Contains(activePath, "/tags")
	}
	if target == "/admin/tags" {
		return strings.HasPrefix(activePath, "/admin/tags")
	}
	if target == "/admin/templates" {
		return strings.HasPrefix(activePath, "/admin/templates")
	}
	if target == "/admin/webhooks" {
		return strings.HasPrefix(activePath, "/admin/webhooks") || strings.Contains(activePath, "/webhooks")
	}
	if target == "/admin/telemetry" {
		return strings.HasPrefix(activePath, "/admin/telemetry")
	}
	return false
}

func isTopLevelActive(activePath, target string) bool {
	if target == "/admin/" {
		return activePath == "/admin" || activePath == "/admin/"
	}
	if target == "/admin/inbox" {
		return strings.HasPrefix(activePath, "/admin/inbox")
	}
	if target == "/admin/campaigns" {
		return strings.HasPrefix(activePath, "/admin/campaigns") || strings.Contains(activePath, "/campaigns")
	}
	return false
}

templ Sidebar() {
	<nav class="sidebar bg-[#fbfbfa] dark:bg-[#202020] border-r border-[#e9e9e7] dark:border-[#2f2f2f] text-[#37352f] dark:text-[#e3e3e3] flex flex-col justify-between shrink-0 h-screen font-sans">
		<div class="sidebar-header flex justify-between items-center px-4 py-3 border-b border-[#e9e9e7] dark:border-[#2f2f2f]">
			<h2 class="text-lg font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3] font-['Outfit',sans-serif]">PerGo</h2>
			<button type="button" class="btn btn-ghost btn-xs text-[#787774] hover:text-[#0284c7] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 p-1" onclick="document.querySelector('.sidebar').classList.toggle('collapsed')">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
			</button>
		</div>
		@WorkspaceSelector(getActiveWorkspace(ctx), getWorkspacesList(ctx))
		<ul class="sidebar-nav p-3 space-y-1">
			<li>
				<a href="/admin/" class={ "nav-item group flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isTopLevelActive(getActivePath(ctx), "/admin/")), templ.KV("text-[#37352f] dark:text-[#e3e3e3] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-zinc-900 dark:hover:text-white", !isTopLevelActive(getActivePath(ctx), "/admin/")) }>
					<svg xmlns="http://www.w3.org/2000/svg" class={ "h-4 w-4 inline shrink-0 transition-colors", templ.KV("text-sky-600 dark:text-sky-400", isTopLevelActive(getActivePath(ctx), "/admin/")), templ.KV("text-[#787774] group-hover:text-[#0284c7]", !isTopLevelActive(getActivePath(ctx), "/admin/")) } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
					<span>{ i18n.T(ctx, "sidebar.overview") }</span>
				</a>
			</li>
			<li>
				<a href="/admin/inbox" class={ "nav-item group flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isTopLevelActive(getActivePath(ctx), "/admin/inbox")), templ.KV("text-[#37352f] dark:text-[#e3e3e3] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-zinc-900 dark:hover:text-white", !isTopLevelActive(getActivePath(ctx), "/admin/inbox")) }>
					<svg xmlns="http://www.w3.org/2000/svg" class={ "h-4 w-4 inline shrink-0 transition-colors", templ.KV("text-sky-600 dark:text-sky-400", isTopLevelActive(getActivePath(ctx), "/admin/inbox")), templ.KV("text-[#787774] group-hover:text-[#0284c7]", !isTopLevelActive(getActivePath(ctx), "/admin/inbox")) } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
					<span>{ i18n.T(ctx, "sidebar.inbox") }</span>
					<span id="inbox-unread-badge" class="hidden ml-auto text-xs font-bold bg-[#0284c7] text-white px-1.5 py-0.5 rounded-full"></span>
				</a>
			</li>

			<li>
				<a href="/admin/campaigns" class={ "nav-item group flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isTopLevelActive(getActivePath(ctx), "/admin/campaigns")), templ.KV("text-[#37352f] dark:text-[#e3e3e3] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-zinc-900 dark:hover:text-white", !isTopLevelActive(getActivePath(ctx), "/admin/campaigns")) }>
					<svg xmlns="http://www.w3.org/2000/svg" class={ "h-4 w-4 inline shrink-0 transition-colors", templ.KV("text-sky-600 dark:text-sky-400", isTopLevelActive(getActivePath(ctx), "/admin/campaigns")), templ.KV("text-[#787774] group-hover:text-[#0284c7]", !isTopLevelActive(getActivePath(ctx), "/admin/campaigns")) } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
					<span>{ i18n.T(ctx, "sidebar.campaigns") }</span>
				</a>
			</li>

			<li>
				<button type="button" onclick="toggleSettingsSubmenu()" class={ "nav-item group w-full flex items-center justify-between px-3 py-2 text-sm font-medium rounded-lg transition-all hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-zinc-900 dark:hover:text-white", templ.KV("text-[#37352f] dark:text-[#e3e3e3] font-semibold", isSettingsActive(getActivePath(ctx))), templ.KV("text-[#787774] dark:text-[#9b9b9b]", !isSettingsActive(getActivePath(ctx))) }>
					<span class="flex items-center gap-3">
						<svg xmlns="http://www.w3.org/2000/svg" class={ "h-4 w-4 inline shrink-0 transition-colors", templ.KV("text-[#0284c7]", isSettingsActive(getActivePath(ctx))), templ.KV("text-[#787774] group-hover:text-[#0284c7]", !isSettingsActive(getActivePath(ctx))) } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
						<span>{ i18n.T(ctx, "sidebar.settings") }</span>
					</span>
					<svg id="chevron-icon" class={ "h-4 w-4 transform transition-transform duration-200 text-[#787774]", templ.KV("rotate-180 text-[#0284c7]", isSettingsActive(getActivePath(ctx))) } fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
				
				<ul id="settings-submenu" class={ "transition-all duration-200 pl-10 mt-1 space-y-1 overflow-hidden", templ.KV("max-h-[380px] opacity-100", isSettingsActive(getActivePath(ctx))), templ.KV("max-h-0 opacity-0", !isSettingsActive(getActivePath(ctx))) }>
					<li>
						<a href="/admin/connections" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/connections")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/connections")) }>{ i18n.T(ctx, "sidebar.connections") }</a>
					</li>
					<li>
						<a href="/admin/developers" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/developers")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/developers")) }>{ i18n.T(ctx, "sidebar.developers") }</a>
					</li>
					<li>
						<a href="/admin/logs" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/logs")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/logs")) }>{ i18n.T(ctx, "sidebar.logs") }</a>
					</li>
					<li>
						<a href="/admin/workspace" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/workspace")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/workspace")) }>{ i18n.T(ctx, "sidebar.workspace") }</a>
					</li>
					<li>
						<a href="/admin/tags" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/tags")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/tags")) }>{ i18n.T(ctx, "sidebar.tags_and_contacts") }</a>
					</li>
					<li>
						<a href="/admin/templates" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/templates")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/templates")) }>{ i18n.T(ctx, "sidebar.waba_templates") }</a>
					</li>
					<li>
						<a href="/admin/webhooks" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/webhooks")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/webhooks")) }>{ i18n.T(ctx, "sidebar.webhooks") }</a>
					</li>
					<li>
						<a href="/admin/telemetry" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/admin/telemetry")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/admin/telemetry")) }>{ i18n.T(ctx, "sidebar.telemetry") }</a>
					</li>
					<li>
						<a href="/admin/integrations/chatwoot" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/integrations/chatwoot")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/integrations/chatwoot")) }>{ i18n.T(ctx, "sidebar.chatwoot") }</a>
					</li>
					<li>
						<a href="/admin/integrations/typebot" class={ "block px-3 py-1.5 text-xs font-medium rounded-md transition-all", templ.KV("bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 font-semibold", isSubmenuActive(getActivePath(ctx), "/integrations/typebot")), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 hover:text-[#37352f] dark:hover:text-[#e3e3e3]", !isSubmenuActive(getActivePath(ctx), "/integrations/typebot")) }>{ i18n.T(ctx, "sidebar.typebot") }</a>
					</li>
				</ul>
			</li>
		</ul>
		<div class="sidebar-footer p-3 border-t border-[#e9e9e7] dark:border-[#2f2f2f] space-y-2">
			@LanguageSwitcher()
			<form method="POST" action="/admin/logout">
				<button type="submit" class="nav-item group logout-btn flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg text-[#787774] dark:text-[#9b9b9b] hover:bg-rose-50 dark:hover:bg-rose-950/30 hover:text-rose-600 dark:hover:text-rose-400 transition-all w-full">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline shrink-0 text-[#787774] group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
					<span>{ i18n.T(ctx, "sidebar.logout") }</span>
				</button>
			</form>
		</div>
		<script>
			function toggleSettingsSubmenu() {
				const submenu = document.getElementById('settings-submenu');
				const chevron = document.getElementById('chevron-icon');
				const isExpanded = submenu.style.maxHeight === '240px' || submenu.classList.contains('max-h-[240px]');
				
				if (isExpanded) {
					submenu.style.maxHeight = '0px';
					submenu.style.opacity = '0';
					submenu.classList.remove('max-h-[240px]', 'opacity-100');
					chevron.classList.remove('rotate-180');
				} else {
					submenu.style.maxHeight = '240px';
					submenu.style.opacity = '1';
					submenu.classList.add('max-h-[240px]', 'opacity-100');
					chevron.classList.add('rotate-180');
				}
			}
		</script>
	</nav>
}

templ LanguageSwitcher() {
	{{ currentLocale := i18n.GetLocale(ctx) }}
	<div class="language-switcher flex items-center justify-between px-1 py-1.5 text-xs" role="region" aria-label={ i18n.T(ctx, "language_switcher.select_language") }>
		<div class="flex items-center gap-2 text-[#787774] dark:text-[#9b9b9b]">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
			</svg>
			<span class="lang-label font-medium">{ i18n.T(ctx, "footer.language") }</span>
		</div>
		<div class="inline-flex rounded-lg p-0.5 bg-[#e9e9e7] dark:bg-[#2f2f2f] border border-[#e9e9e7] dark:border-[#2f2f2f]" role="group" aria-label={ i18n.T(ctx, "language_switcher.select_language") }>
			<button
				type="button"
				hx-post="/admin/locale"
				hx-vals='{"locale": "en-US"}'
				hx-swap="none"
				class={ "px-2 py-0.5 rounded-md text-xs font-semibold transition-all cursor-pointer", templ.KV("bg-white dark:bg-[#202020] text-[#0369a1] dark:text-[#38bdf8] shadow-xs", currentLocale == "en-US"), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:text-[#37352f] dark:hover:text-[#e3e3e3]", currentLocale != "en-US") }
				aria-pressed={ templ.EscapeString(fmt.Sprintf("%t", currentLocale == "en-US")) }
				title={ i18n.T(ctx, "language_switcher.en_US") }
			>
				EN
			</button>
			<button
				type="button"
				hx-post="/admin/locale"
				hx-vals='{"locale": "pt-BR"}'
				hx-swap="none"
				class={ "px-2 py-0.5 rounded-md text-xs font-semibold transition-all cursor-pointer", templ.KV("bg-white dark:bg-[#202020] text-[#0369a1] dark:text-[#38bdf8] shadow-xs", currentLocale == "pt-BR"), templ.KV("text-[#787774] dark:text-[#9b9b9b] hover:text-[#37352f] dark:hover:text-[#e3e3e3]", currentLocale != "pt-BR") }
				aria-pressed={ templ.EscapeString(fmt.Sprintf("%t", currentLocale == "pt-BR")) }
				title={ i18n.T(ctx, "language_switcher.pt_BR") }
			>
				PT
			</button>
		</div>
	</div>
}

templ WorkspaceSelector(activeWorkspace *repository.Workspace, workspaces []repository.Workspace) {
	if len(workspaces) > 0 {
		<div id="sidebar-workspace-selector" class="px-4 py-2 border-b border-[#e9e9e7] dark:border-[#2f2f2f]">
			<label class="block text-xs font-semibold text-[#787774] dark:text-[#9b9b9b] uppercase tracking-wider mb-1">{ i18n.T(ctx, "sidebar.workspace_label") }</label>
			<select name="workspace_id" 
			        hx-post="/admin/workspaces/active" 
			        hx-trigger="change" 
			        hx-swap="none" 
			        class="select select-bordered select-xs w-full max-w-xs font-medium text-[#37352f] dark:text-[#e3e3e3] bg-white dark:bg-[#202020] border-[#e9e9e7] dark:border-[#2f2f2f] focus:outline-none focus:border-[#0284c7]">
				for _, ws := range workspaces {
					if activeWorkspace != nil && ws.ID == activeWorkspace.ID {
						<option value={ ws.ID.String() } selected>{ ws.Name }</option>
					} else {
						<option value={ ws.ID.String() }>{ ws.Name }</option>
					}
				}
			</select>
		</div>
	} else {
		<div id="sidebar-workspace-selector" hx-get="/admin/workspaces/selector" hx-trigger="load" hx-swap="outerHTML"></div>
	}
}
