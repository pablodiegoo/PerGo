package pages

import (
	"fmt"

	"github.com/pablojhp.pergo/internal/i18n"
	"github.com/pablojhp.pergo/internal/platform/audit"
	"github.com/pablojhp.pergo/internal/repository"
)

templ Dashboard(
	ws *repository.Workspace,
	allWorkspaces []repository.Workspace,
	wsCount int,
	recentAuditCount int,
	isOnboarded bool,
	apiKeysCount int,
	activeConnectionsCount int,
	connections []*repository.Connection,
	recentLogs []audit.RecentEntry,
) {
	<div class="dashboard w-full space-y-6 text-[#37352f] dark:text-[#e3e3e3] font-sans">
		<!-- Header -->
		<div class="flex justify-between items-center border-b border-[#e9e9e7] dark:border-[#2f2f2f] pb-4">
			<div>
				<h1 class="text-2xl font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3] font-['Outfit',sans-serif]">{ i18n.T(ctx, "dashboard.title") }</h1>
				<p class="text-sm text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "sidebar.workspace") }: <span class="font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ ws.Name }</span></p>
			</div>
			<div class="flex items-center gap-2">
				<!-- Webhook Simulation Trigger -->
				if isOnboarded {
					<form hx-post="/admin/webhook/simulate" hx-target="#simulation-result" hx-swap="outerHTML" class="flex items-center gap-2">
						<input type="hidden" name="workspace_id" value={ ws.ID.String() }/>
						<select name="event_type" class="select select-bordered select-sm text-[#37352f] dark:text-[#e3e3e3] bg-white dark:bg-[#202020] border-[#e9e9e7] dark:border-[#2f2f2f] focus:outline-none focus:border-[#0284c7]">
							<option value="message.delivered">message.delivered</option>
							<option value="message.failed">message.failed</option>
							<option value="message.inbound">message.inbound</option>
						</select>
						<button type="submit" class="btn btn-sm bg-[#0369a1] hover:bg-[#0284c7] text-white border-none rounded-lg px-3 py-1.5 font-medium transition-colors">
							{ i18n.T(ctx, "dashboard.simulate_webhook") }
						</button>
					</form>
				}
			</div>
		</div>

		<div id="simulation-result"></div>

		<!-- Dashboard Content -->
		if !isOnboarded {
			@OnboardingChecklist(ws, apiKeysCount, activeConnectionsCount)
		} else {
			@OperationalDashboard(ws, wsCount, recentAuditCount, apiKeysCount, connections, recentLogs)
		}

		<!-- Re-pairing Modal -->
		<div id="dashboard-qr-modal" class="modal">
			<div class="modal-box bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] shadow-xl max-w-md">
				<h3 class="font-bold text-lg text-[#37352f] dark:text-[#e3e3e3] font-['Outfit',sans-serif] border-b border-[#e9e9e7] dark:border-[#2f2f2f] pb-2">{ i18n.T(ctx, "dashboard.link_whatsapp") }</h3>
				<div class="py-4">
					<div id="qr-area" class="min-h-[250px] flex items-center justify-center">
						<p class="text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.generating_qr") }</p>
					</div>
				</div>
				<div class="modal-action border-t border-[#e9e9e7] dark:border-[#2f2f2f] pt-2">
					<button class="btn btn-sm btn-outline text-[#37352f] dark:text-[#e3e3e3] border-[#e9e9e7] dark:border-[#2f2f2f] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50" onclick="document.getElementById('dashboard-qr-modal').classList.remove('modal-open')">
						{ i18n.T(ctx, "common.actions.close") }
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ OnboardingChecklist(ws *repository.Workspace, apiKeysCount int, connectionsCount int) {
	<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-6 shadow-none space-y-6 max-w-xl mx-auto mt-8">
		<div>
			<h2 class="text-lg font-bold text-[#37352f] dark:text-[#e3e3e3] font-['Outfit',sans-serif]">{ i18n.T(ctx, "dashboard.get_started") }</h2>
			<p class="text-sm text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.get_started_subtitle", "name", ws.Name) }</p>
		</div>

		<div class="space-y-4">
			<!-- Step 1: Create Workspace -->
			<div class="flex items-start gap-3">
				<div class="flex items-center justify-center w-6 h-6 rounded-full bg-[#0369a1] text-white text-xs font-bold shrink-0">
					<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
				</div>
				<div>
					<h3 class="text-sm font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ i18n.T(ctx, "dashboard.step_workspace") }</h3>
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.step_workspace_desc") }</p>
				</div>
			</div>

			<!-- Step 2: Link messaging connection -->
			<div class="flex items-start gap-3">
				if connectionsCount > 0 {
					<div class="flex items-center justify-center w-6 h-6 rounded-full bg-[#0369a1] text-white text-xs font-bold shrink-0">
						<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
					</div>
				} else {
					<div class="flex items-center justify-center w-6 h-6 rounded-full border-2 border-[#e9e9e7] dark:border-[#2f2f2f] text-[#787774] dark:text-[#9b9b9b] text-xs font-bold shrink-0">
						2
					</div>
				}
				<div class="flex-1">
					<div class="flex justify-between items-center">
						<h3 class="text-sm font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ i18n.T(ctx, "dashboard.step_connection") }</h3>
						if connectionsCount == 0 {
							<a href="/admin/devices" class="text-xs font-bold text-[#0369a1] dark:text-[#38bdf8] underline">{ i18n.T(ctx, "dashboard.link_account") }</a>
						}
					</div>
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.step_connection_desc") }</p>
				</div>
			</div>

			<!-- Step 3: Generate API Key -->
			<div class="flex items-start gap-3">
				if apiKeysCount > 0 {
					<div class="flex items-center justify-center w-6 h-6 rounded-full bg-[#0369a1] text-white text-xs font-bold shrink-0">
						<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
					</div>
				} else {
					<div class="flex items-center justify-center w-6 h-6 rounded-full border-2 border-[#e9e9e7] dark:border-[#2f2f2f] text-[#787774] dark:text-[#9b9b9b] text-xs font-bold shrink-0">
						3
					</div>
				}
				<div class="flex-1">
					<div class="flex justify-between items-center">
						<h3 class="text-sm font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ i18n.T(ctx, "dashboard.step_api_key") }</h3>
						if apiKeysCount == 0 {
							<a href={ templ.URL(fmt.Sprintf("/admin/workspaces?id=%s", ws.ID.String())) } class="text-xs font-bold text-[#0369a1] dark:text-[#38bdf8] underline">{ i18n.T(ctx, "dashboard.generate_key") }</a>
						}
					</div>
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.step_api_key_desc") }</p>
				</div>
			</div>

			<!-- Step 4: Send your first message -->
			<div class="flex items-start gap-3">
				<div class="flex items-center justify-center w-6 h-6 rounded-full border-2 border-[#e9e9e7] dark:border-[#2f2f2f] text-[#787774] dark:text-[#9b9b9b] text-xs font-bold shrink-0">
					4
				</div>
				<div>
					<h3 class="text-sm font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ i18n.T(ctx, "dashboard.step_first_message") }</h3>
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">{ i18n.T(ctx, "dashboard.step_first_message_desc") }</p>
					if apiKeysCount > 0 && connectionsCount > 0 {
						<pre class="mt-2 p-3 bg-[#fbfbfa] dark:bg-[#191919] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg font-mono text-[11px] text-[#37352f] dark:text-[#e3e3e3] overflow-x-auto">
							{ `curl -X POST http://localhost:8080/messages \
  -H "Authorization: Bearer YOUR_API_KEY" \
  -H "Content-Type: application/json" \
  -d '{"to": "+5511999999999", "channel": "whatsapp", "content": "Hello World"}'` }
						</pre>
					}
				</div>
			</div>
		</div>
	</div>
}

templ OperationalDashboard(
	ws *repository.Workspace,
	wsCount int,
	recentAuditCount int,
	apiKeysCount int,
	connections []*repository.Connection,
	recentLogs []audit.RecentEntry,
) {
	<!-- Telemetry Overview Widgets -->
	<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-5 shadow-none">
			<div class="text-2xl font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3]">{ fmt.Sprintf("%d", len(connections)) }</div>
			<div class="text-xs text-[#787774] dark:text-[#9b9b9b] font-medium uppercase mt-1">{ i18n.T(ctx, "connections.title") }</div>
		</div>
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-5 shadow-none">
			<div class="text-2xl font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3]">{ fmt.Sprintf("%d", apiKeysCount) }</div>
			<div class="text-xs text-[#787774] dark:text-[#9b9b9b] font-medium uppercase mt-1">{ i18n.T(ctx, "dashboard.api_keys") }</div>
		</div>
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-5 shadow-none">
			<div class="text-2xl font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3]">{ fmt.Sprintf("%d", recentAuditCount) }</div>
			<div class="text-xs text-[#787774] dark:text-[#9b9b9b] font-medium uppercase mt-1">{ i18n.T(ctx, "dashboard.recent_activity") }</div>
		</div>
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-5 shadow-none">
			<div class="text-2xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">{ i18n.T(ctx, "common.status.active") }</div>
			<div class="text-xs text-[#787774] dark:text-[#9b9b9b] font-medium uppercase mt-1">{ i18n.T(ctx, "dashboard.system_status") }</div>
		</div>
	</div>

	<!-- Connections Grid -->
	<div class="space-y-3">
		<h2 class="text-sm font-bold text-[#787774] dark:text-[#9b9b9b] uppercase tracking-wider">{ i18n.T(ctx, "dashboard.active_channel_connections") }</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			for _, conn := range connections {
				<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-5 shadow-none flex flex-col justify-between space-y-4">
					<div class="flex justify-between items-start">
						<div>
							<h3 class="font-bold text-[#37352f] dark:text-[#e3e3e3]">{ conn.Name }</h3>
							<p class="text-xs text-[#787774] dark:text-[#9b9b9b] capitalize">{ conn.Channel }</p>
						</div>
						<!-- Status Badge -->
						if conn.Status == "connected" {
							<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
								{ i18n.T(ctx, "common.status.connected") }
							</span>
						} else {
							<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-[#fbfbfa] dark:bg-[#191919] text-[#787774] dark:text-[#9b9b9b] border border-[#e9e9e7] dark:border-[#2f2f2f]">
								{ i18n.T(ctx, "common.status.disconnected") }
							</span>
						}
					</div>

					<div class="flex items-center justify-between pt-2 border-t border-[#e9e9e7] dark:border-[#2f2f2f] text-xs">
						<span class="text-[#787774] dark:text-[#9b9b9b]">Identity: <code class="font-mono text-[#37352f] dark:text-[#e3e3e3]">{ conn.SenderIdentity }</code></span>
						
						<!-- WhatsApp Web Re-pairing Button -->
						if conn.Channel == "whatsapp" && conn.Status != "connected" {
							<button class="btn btn-xs btn-outline border-[#e9e9e7] dark:border-[#2f2f2f] text-[#37352f] dark:text-[#e3e3e3] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 font-semibold rounded-md"
							        hx-post={ "/admin/devices/pair?connection_id=" + conn.ID.String() }
							        hx-target="#qr-area"
							        hx-swap="innerHTML"
							        onclick="document.getElementById('dashboard-qr-modal').classList.add('modal-open')">
								{ i18n.T(ctx, "common.actions.pair") }
							</button>
						}
					</div>
				</div>
			}
			if len(connections) == 0 {
				<div class="col-span-full bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl p-6 text-center text-[#787774] dark:text-[#9b9b9b] italic">
					{ i18n.T(ctx, "connections.no_connections") }
				</div>
			}
		</div>
	</div>

	<!-- Recent Audit Log Table -->
	<div class="space-y-3">
		<div class="flex justify-between items-center">
			<h2 class="text-sm font-bold text-[#787774] dark:text-[#9b9b9b] uppercase tracking-wider">{ i18n.T(ctx, "dashboard.recent_activity") }</h2>
			<a href="/admin/audit/outbound" class="text-xs font-semibold text-[#0369a1] dark:text-[#38bdf8] underline">{ i18n.T(ctx, "dashboard.view_all_logs") }</a>
		</div>
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-xl shadow-none overflow-hidden">
			<table class="table w-full text-[#37352f] dark:text-[#e3e3e3]">
				<thead>
					<tr class="bg-[#fbfbfa] dark:bg-[#191919] text-[#787774] dark:text-[#9b9b9b] border-b border-[#e9e9e7] dark:border-[#2f2f2f]">
						<th class="px-4 py-2 text-left text-xs font-semibold uppercase">{ i18n.T(ctx, "dashboard.event_type") }</th>
						<th class="px-4 py-2 text-left text-xs font-semibold uppercase">{ i18n.T(ctx, "dashboard.trace_id") }</th>
						<th class="px-4 py-2 text-left text-xs font-semibold uppercase">{ i18n.T(ctx, "dashboard.timestamp") }</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-[#e9e9e7] dark:divide-[#2f2f2f]">
					for _, log := range recentLogs {
						<tr class="hover:bg-[#fbfbfa] dark:hover:bg-[#191919] text-xs">
							<td class="px-4 py-3 font-semibold text-[#37352f] dark:text-[#e3e3e3]">{ log.EventType }</td>
							<td class="px-4 py-3 font-mono text-[#787774] dark:text-[#9b9b9b]">{ log.TraceID }</td>
							<td class="px-4 py-3 text-[#787774] dark:text-[#9b9b9b]">{ log.CreatedAt.Format("2006-01-02 15:04:05") }</td>
						</tr>
					}
					if len(recentLogs) == 0 {
						<tr>
							<td colspan="3" class="px-4 py-6 text-center text-[#787774] dark:text-[#9b9b9b] italic">{ i18n.T(ctx, "dashboard.no_activity_logs") }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
