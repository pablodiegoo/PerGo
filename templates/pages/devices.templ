package pages

import (
	"fmt"
	"github.com/pablojhp.pergo/internal/repository"
	"github.com/pablojhp.pergo/templates/components"
	"github.com/pablojhp.pergo/templates/layout"
)

// DeviceListPage renders the full connection management page with layout.
templ DeviceListPage(connections []*repository.Connection) {
	@layout.Base("Conexões", DeviceListContent(connections))
}

// DeviceListContent renders the connection list content (HTMX fragment or full page body).
templ DeviceListContent(connections []*repository.Connection) {
	<div class="border-b border-zinc-200 pb-5 mb-8 flex justify-between items-end">
		<div>
			<h1 class="text-2xl font-bold tracking-tight text-zinc-900">Conexões</h1>
			<p class="text-zinc-500 text-sm mt-1">Conecte e autentique seus canais de comunicação unificados.</p>
		</div>
		<button
			class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-sm font-semibold px-4 py-2 rounded-md transition"
			hx-get="/admin/devices/pair-form"
			hx-target="#modal-container"
			hx-swap="innerHTML"
		>
			Nova Conexão
		</button>
	</div>
	<div id="connections-table-container" class="bg-white border border-zinc-200 rounded-lg p-6 shadow-sm mb-6">
		@ConnectionTable(connections)
	</div>
}

// ConnectionTable renders the connection list table.
templ ConnectionTable(connections []*repository.Connection) {
	<div class="overflow-x-auto border border-zinc-200 rounded-lg shadow-sm">
		<table class="table min-w-full divide-y divide-zinc-200" id="device-table">
			<thead class="bg-zinc-50 text-zinc-500 text-xs font-semibold uppercase tracking-wider text-left border-b border-zinc-200">
				<tr>
					<th class="px-6 py-3">Nome</th>
					<th class="px-6 py-3">Slug (API)</th>
					<th class="px-6 py-3">Canal</th>
					<th class="px-6 py-3">Status</th>
					<th class="px-6 py-3">Identidade</th>
					<th class="px-6 py-3">Conectado Desde</th>
					<th class="px-6 py-3 text-right">Ações</th>
				</tr>
			</thead>
			<tbody id="device-list-body" class="divide-y divide-zinc-200 text-sm text-zinc-700 bg-white">
				for _, conn := range connections {
					@ConnectionRow(conn)
				}
				if len(connections) == 0 {
					<tr>
						<td colspan="7" class="px-6 py-12 text-center text-zinc-400">Nenhuma conexão cadastrada. Clique em "Nova Conexão" para começar.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// ConnectionRow renders a single connection row inside the list table.
templ ConnectionRow(conn *repository.Connection) {
	<tr class="device-row hover:bg-zinc-50/50 transition-colors" id={ "connection-row-" + conn.ID.String() }>
		<td class="px-6 py-4 font-semibold text-zinc-900">{ conn.Name }</td>
		<td class="px-6 py-4 font-mono text-xs">
			<form
				hx-post={ "/admin/devices/" + conn.ID.String() + "/slug" }
				hx-target="#connections-table-container"
				hx-swap="innerHTML"
				class="inline-flex items-center gap-1"
			>
				<input
					type="text"
					name="slug"
					value={ conn.Slug }
					required
					aria-label={ "Editar slug da conexão " + conn.Name }
					class="form-input text-xs font-mono px-2 py-0.5 border border-zinc-200 rounded bg-zinc-50 focus:bg-white focus:border-zinc-400 focus:outline-none w-36 font-semibold text-zinc-800"
					title="Clique para editar e pressione Enter para salvar"
				/>
			</form>
		</td>
		<td class="px-6 py-4">
			@ChannelIcon(conn.Channel)
		</td>
		<td class="px-6 py-4">
			@ConnectionStatusBadge(conn.Status)
		</td>
		<td class="px-6 py-4 font-mono text-xs text-zinc-500">{ conn.SenderIdentity }</td>
		<td class="px-6 py-4 text-xs font-mono text-zinc-500">
			if conn.ConnectedSince != nil {
				{ conn.ConnectedSince.Format("02/01/2006 15:04:05") }
			} else {
				<span class="text-zinc-300">—</span>
			}
		</td>
		<td class="px-6 py-4 text-right">
			<div class="inline-flex gap-2">
				<a
					href={ templ.URL("/admin/inbox?channel=" + conn.Channel) }
					class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold"
				>
					Inbox
				</a>
				if conn.Channel == "whatsapp_cloud" {
					<button
						class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold"
						hx-get={ "/admin/devices/flow-key?id=" + conn.ID.String() }
						hx-target="body"
						hx-swap="beforeend"
					>
						Chave Flows
					</button>
				}
				<button
					class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold"
					hx-get={ "/admin/devices/test?id=" + conn.ID.String() }
					hx-target="body"
					hx-swap="beforeend"
				>
					Testar
				</button>
				<button
					class="btn btn-ghost hover:bg-rose-50 text-rose-600 btn-xs font-semibold"
					hx-delete={ "/admin/devices/" + conn.ID.String() }
					hx-target="#connections-table-container"
					hx-swap="innerHTML"
					hx-confirm={ "Tem certeza que deseja excluir a conexão " + conn.Name + "?" }
				>
					Excluir
				</button>
			</div>
		</td>
	</tr>
}

// ChannelIcon renders a styled badge/icon representing a channel.
templ ChannelIcon(channel string) {
	switch channel {
		case "whatsapp":
			<span class="badge badge-sm bg-emerald-50 text-emerald-700 border-emerald-200 px-2 py-0.5 text-xs font-semibold">
				WhatsApp Web
			</span>
		case "whatsapp_cloud":
			<span class="badge badge-sm bg-green-50 text-green-700 border-green-200 px-2 py-0.5 text-xs font-semibold">
				WhatsApp Cloud
			</span>
		case "telegram":
			<span class="badge badge-sm bg-sky-50 text-sky-700 border-sky-200 px-2 py-0.5 text-xs font-semibold">
				Telegram
			</span>
		default:
			<span class="badge badge-sm bg-zinc-100 text-zinc-700 border-zinc-200 px-2 py-0.5 text-xs font-semibold">
				{ channel }
			</span>
	}
}

// ConnectionStatusBadge renders a status badge with matching color theme.
templ ConnectionStatusBadge(status string) {
	switch status {
		case "connected", "active":
			<span class="badge badge-sm bg-emerald-50 text-emerald-700 border-emerald-200 px-2 py-0.5 text-xs font-semibold">Conectado</span>
		case "disconnected":
			<span class="badge badge-sm bg-amber-50 text-amber-700 border-amber-200 px-2 py-0.5 text-xs font-semibold">Desconectado</span>
		case "terminal":
			<span class="badge badge-sm bg-rose-50 text-rose-700 border-rose-200 px-2 py-0.5 text-xs font-semibold">Terminal</span>
		case "pending":
			<span class="badge badge-sm bg-blue-50 text-blue-700 border-blue-200 px-2 py-0.5 text-xs font-semibold">Pendente</span>
		default:
			<span class="badge badge-sm bg-zinc-100 text-zinc-700 border-zinc-200 px-2 py-0.5 text-xs font-semibold">{ status }</span>
	}
}

// PairForm renders the unified new connection modal form.
templ PairForm() {
	<div class="modal-backdrop" role="presentation" onclick="this.closest('.modal-backdrop').remove()" onkeydown="if(event.key === 'Escape') this.closest('.modal-backdrop').remove()" tabindex="0">
		<div class="custom-modal w-full max-w-lg" role="dialog" aria-modal="true" aria-labelledby="pair-modal-title" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4">
				<h3 id="pair-modal-title" class="text-lg font-bold text-zinc-900">Nova Conexão</h3>
			</div>
			<div class="modal-body space-y-4">
				<div id="modal-error-container"></div>
				<form
					id="new-connection-form"
					class="space-y-4"
					hx-post="/admin/devices/pair"
					hx-target="#qr-area"
					hx-swap="innerHTML"
					hx-indicator="#conn-submit-spinner"
					hx-on::after-request="if(event.detail.successful && !event.detail.xhr.getResponseHeader('HX-Retarget') && document.getElementById('new-channel-select').value !== 'whatsapp') this.closest('.modal-backdrop').remove()"
				>
					<div class="flex flex-col gap-1">
						<label for="new-conn-name" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Nome da Conexão</label>
						<input type="text" id="new-conn-name" name="name" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full" placeholder="Ex: WhatsApp Suporte, Telegram Bot"/>
					</div>

					<div class="flex flex-col gap-1">
						<label for="new-channel-select" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Canal</label>
						<select id="new-channel-select" name="channel" required class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full" onchange="updateChannelFields(this)">
							<option value="whatsapp" selected>WhatsApp Web (Unofficial)</option>
							<option value="whatsapp_cloud">WhatsApp Cloud (WABA)</option>
							<option value="telegram">Telegram Bot</option>
						</select>
					</div>

					<!-- WhatsApp Web Fields -->
					<div id="fields-whatsapp" class="space-y-4">
						@components.BanWarning()
						<div class="rounded-md bg-zinc-50 border border-zinc-200 p-3 text-xs text-zinc-600 space-y-1">
							<p class="font-semibold text-zinc-800">Como parear:</p>
							<p>Ao clicar no botão abaixo, um QR Code será gerado. Abra o <strong>WhatsApp</strong> no seu celular, acesse <strong>Aparelhos Conectados &gt; Conectar um aparelho</strong> e aponte a câmera. O número será reconhecido automaticamente.</p>
						</div>
						<div class="flex flex-col gap-1">
							<label for="proxy_url" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Proxy URL (Opcional)</label>
							<input type="text" id="proxy_url" name="proxy_url" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full" placeholder="socks5://user:pass@host:port ou http://host:port"/>
							<p class="text-[11px] text-zinc-400">Opcional: utilize apenas se seu servidor estiver em Data Center e precisar de um proxy residencial/móvel.</p>
						</div>
					</div>

					<!-- WABA Fields -->
					<div id="fields-waba" style="display: none;" class="space-y-4">
						<div class="flex flex-col gap-1">
							<label for="waba_phone_number_id" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Phone Number ID</label>
							<input type="text" id="waba_phone_number_id" name="phone_number_id" data-required="true" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"/>
						</div>
						<div class="flex flex-col gap-1">
							<label for="waba_account_id" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">WABA Account ID</label>
							<input type="text" id="waba_account_id" name="waba_account_id" data-required="true" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"/>
						</div>
						<div class="flex flex-col gap-1">
							<label for="waba_token" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Meta API Token</label>
							<input type="password" id="waba_token" name="token" data-required="true" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"/>
						</div>
						<div class="flex flex-col gap-1">
							<label for="waba_verify_token" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Verify Token (Optional)</label>
							<input type="text" id="waba_verify_token" name="verify_token" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"/>
						</div>
						<div class="flex flex-col gap-1">
							<label for="waba_private_key" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Flows Private Key PEM (Opcional)</label>
							<textarea id="waba_private_key" name="private_key" rows="3" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full" placeholder="-----BEGIN RSA PRIVATE KEY-----&#10;...&#10;-----END RSA PRIVATE KEY-----&#10;(deixe em branco para gerar automaticamente)"></textarea>
							<p class="text-[11px] text-zinc-400">Chave RSA de 2048 bits para Meta Flows. Se deixada em branco, um par de chaves será gerado automaticamente.</p>
						</div>
					</div>


					<!-- Telegram Fields -->
					<div id="fields-telegram" style="display: none;" class="space-y-4">
						<div class="flex flex-col gap-1">
							<label for="tg_token" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Bot Token</label>
							<input type="password" id="tg_token" name="token" data-required="true" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"/>
						</div>
					</div>

					<div id="qr-area" class="qr-area mt-4"></div>

					<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
						<button type="button" class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center" onclick="this.closest('.modal-backdrop').remove()">Cancelar</button>
						<button type="submit" id="new-conn-submit-btn" class="btn btn-black bg-zinc-950 hover:bg-zinc-900 text-white border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center gap-2">
							<span id="conn-submit-spinner" class="htmx-indicator spinner border-2 border-white border-t-transparent rounded-full w-3.5 h-3.5 animate-spin" aria-hidden="true"></span>
							<span id="new-conn-submit-label">Começar Emparelhamento</span>
						</button>
					</div>
				</form>
			</div>
		</div>
		<script>
			window.updateChannelFields = function(selectEl) {
				const channel = selectEl ? selectEl.value : document.getElementById('new-channel-select').value;
				const form = document.getElementById('new-connection-form');
				const waWebFields = document.getElementById('fields-whatsapp');
				const wabaFields = document.getElementById('fields-waba');
				const tgFields = document.getElementById('fields-telegram');
				const submitLabel = document.getElementById('new-conn-submit-label');
				const connNameInput = document.getElementById('new-conn-name');

				if (!form) return;

				// Hide all
				if (waWebFields) waWebFields.style.display = 'none';
				if (wabaFields) wabaFields.style.display = 'none';
				if (tgFields) tgFields.style.display = 'none';

				// Reset required
				if (wabaFields) wabaFields.querySelectorAll('input').forEach(i => i.required = false);
				if (tgFields) tgFields.querySelectorAll('input').forEach(i => i.required = false);

				if (channel === 'whatsapp') {
					if (waWebFields) waWebFields.style.display = 'block';
					if (connNameInput) connNameInput.required = false;
					if (submitLabel) submitLabel.innerText = 'Começar Emparelhamento';
					form.setAttribute('hx-post', '/admin/devices/pair');
					form.setAttribute('hx-target', '#qr-area');
					form.setAttribute('hx-swap', 'innerHTML');
				} else if (channel === 'whatsapp_cloud') {
					if (wabaFields) {
						wabaFields.style.display = 'block';
						wabaFields.querySelectorAll('input[data-required="true"]').forEach(i => i.required = true);
					}
					if (connNameInput) connNameInput.required = true;
					if (submitLabel) submitLabel.innerText = 'Salvar Conexão';
					form.setAttribute('hx-post', '/admin/devices/create');
					form.setAttribute('hx-target', '#connections-table-container');
					form.setAttribute('hx-swap', 'innerHTML');
				} else if (channel === 'telegram') {
					if (tgFields) {
						tgFields.style.display = 'block';
						tgFields.querySelectorAll('input[data-required="true"]').forEach(i => i.required = true);
					}
					if (connNameInput) connNameInput.required = true;
					if (submitLabel) submitLabel.innerText = 'Salvar Conexão';
					form.setAttribute('hx-post', '/admin/devices/create');
					form.setAttribute('hx-target', '#connections-table-container');
					form.setAttribute('hx-swap', 'innerHTML');
				}
				if (window.htmx) {
					htmx.process(form);
				}
			};
		</script>
	</div>
}

// QRFragment renders the current QR code state as an HTMX-refreshable fragment.
templ QRFragment(code string, qrPNG string, phone string, status string, message string) {
	<div class="qr-fragment" id="qr-area" role="region" aria-label="Status do Emparelhamento WhatsApp">
		@components.BanWarning()
		if message != "" {
			<p class="qr-status mb-3 text-xs text-zinc-500 font-medium text-center" role="status" aria-live="polite">{ message }</p>
		}
		switch status {
			case "pending":
				if qrPNG != "" {
					<div class="qr-container bg-white border border-zinc-200 rounded-xl p-5 shadow-sm flex flex-col items-center max-w-xs mx-auto" role="status" aria-live="polite">
						<div class="qr-image-wrapper bg-white p-2 rounded-lg border border-zinc-100 shadow-inner mb-3">
							<img
								src={ templ.SafeURL(qrPNG) }
								alt="WhatsApp QR Code para leitura no aplicativo móvel"
								class="w-56 h-56 object-contain block mx-auto select-none"
							/>
						</div>
						<div class="flex items-center gap-2 text-xs text-zinc-500 font-medium">
							<div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
							<span>Aguardando leitura no WhatsApp...</span>
						</div>
					</div>
				} else if code != "" {
					<div class="qr-container bg-white border border-zinc-200 rounded-xl p-5 shadow-sm flex flex-col items-center max-w-xs mx-auto" role="status" aria-live="polite">
						<div class="qr-code-raw bg-zinc-50 p-3 border border-zinc-200 rounded font-mono text-xs select-all break-all text-zinc-700 mb-3" data-qr={ code }>
							<code>{ code }</code>
						</div>
						<div class="flex items-center gap-2 text-xs text-zinc-500 font-medium">
							<div class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></div>
							<span>Gerando imagem do QR code...</span>
						</div>
					</div>
				} else {
					<div class="qr-loading flex flex-col items-center py-8" role="status" aria-live="polite">
						<div class="spinner border-2 border-zinc-950 border-t-transparent rounded-full w-8 h-8 animate-spin mb-3" aria-hidden="true"></div>
						<p class="text-xs text-zinc-500 font-medium">Inicializando sessão WhatsApp Web...</p>
					</div>
				}
				<div
					hx-get={ "/admin/devices/qr?id=" + phone }
					hx-trigger="every 2s"
					hx-target="#qr-area"
					hx-swap="innerHTML"
				></div>
			case "paired":
				<div class="qr-success text-center py-6 bg-emerald-50/50 border border-emerald-100 rounded-xl p-5 max-w-sm mx-auto" role="status" aria-live="polite">
					<div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl font-bold" aria-hidden="true">
						✓
					</div>
					<h3 class="text-base font-bold text-zinc-900 mb-1">Dispositivo Pareado com Sucesso!</h3>
					if phone != "" {
						<p class="text-xs text-zinc-500 mb-4 font-mono">{ phone }</p>
					}
					<button
						class="btn btn-black bg-zinc-950 hover:bg-zinc-900 text-white px-5 py-2 rounded-md font-semibold text-xs border-none shadow-sm transition"
						onclick="
							const table = document.getElementById('connections-table-container');
							const form = document.getElementById('campaign-create-form');
							if (table) {
								htmx.ajax('GET', '/admin/devices', {target: 'main', swap: 'innerHTML'});
							} else if (form) {
								document.body.dispatchEvent(new CustomEvent('connection-created', { bubbles: true }));
							}
							this.closest('.modal-backdrop').remove();
						"
					>
						Ver Conexões
					</button>
				</div>
			case "error":
				<div class="qr-error text-center py-6 bg-rose-50/50 border border-rose-100 rounded-xl p-5 max-w-sm mx-auto" role="alert" aria-live="assertive">
					<div class="w-12 h-12 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold" aria-hidden="true">
						✕
					</div>
					<h3 class="text-base font-bold text-zinc-900 mb-1">Falha no Pareamento</h3>
					<p class="text-xs text-rose-600 mb-4 font-medium">{ message }</p>
					<button
						class="btn btn-secondary px-4 py-2 border border-zinc-300 rounded-md text-zinc-700 hover:bg-zinc-50 font-semibold text-xs transition"
						onclick="
							const modalContainer = document.getElementById('modal-container');
							if (modalContainer) {
								htmx.ajax('GET', '/admin/devices/pair-form', {target: '#modal-container', swap: 'innerHTML'});
							} else {
								htmx.ajax('GET', '/admin/devices/pair-form', {target: 'body', swap: 'beforeend'});
							}
							this.closest('.modal-backdrop').remove();
						"
					>
						Tentar Novamente
					</button>
				</div>
		}
	</div>
}

// TestConnectionModal renders the modal to test message sending and view NATS streams.
templ TestConnectionModal(conn *repository.Connection, templates []repository.WABATemplate) {
	<script src="https://unpkg.com/htmx-ext-ws@2.0.1/ws.js"></script>
	<div class="modal-backdrop" role="presentation" onclick="this.closest('.modal-backdrop').remove()" onkeydown="if(event.key === 'Escape') this.closest('.modal-backdrop').remove()" tabindex="0">
		<div class="custom-modal w-full max-w-4xl" role="dialog" aria-modal="true" aria-labelledby="test-modal-title" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4">
				<h3 id="test-modal-title" class="text-lg font-bold text-zinc-900">Testar Conexão: { conn.Name }</h3>
			</div>
			<div class="modal-body grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Left column: Send form -->
				<div>
					<div id="test-form-alert"></div>
					<form
						hx-post="/admin/devices/test"
						hx-target="#test-form-alert"
						hx-swap="innerHTML"
						hx-indicator="#test-submit-spinner"
						class="space-y-4"
					>
						<input type="hidden" name="connection_id" value={ conn.ID.String() }/>

						<div class="grid grid-cols-2 gap-4 text-xs mb-2 bg-zinc-50 p-3 border border-zinc-200/60 rounded">
							<div>
								<span class="block text-zinc-400 font-semibold uppercase">Canal</span>
								<span class="font-medium text-zinc-950">{ conn.Channel }</span>
							</div>
							<div>
								<span class="block text-zinc-400 font-semibold uppercase">Identidade</span>
								<span class="font-mono text-zinc-950 font-medium">{ conn.SenderIdentity }</span>
							</div>
						</div>

						<div class="flex flex-col gap-1">
							<label for="test-to" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Destinatário</label>
							<input
								type="text"
								name="to"
								id="test-to"
								class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"
								placeholder="Ex: 5511999999999 or Telegram chat_id"
								required
							/>
						</div>

						if conn.Channel == "whatsapp_cloud" {
							<input type="hidden" name="is_template" value="true" />
							<input type="hidden" name="language" id="test-template-language" value="" />
							<div class="flex flex-col gap-1">
								<label for="test-template-name" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Template</label>
								<select
									name="template_name"
									id="test-template-name"
									class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full"
									required
									onchange="showTestTemplatePreview(this)"
								>
									<option value="">Selecione um template...</option>
									for _, t := range templates {
										<option
											value={ t.Name }
											data-language={ t.Language }
											data-components={ string(t.Components) }
										>{ fmt.Sprintf("%s (%s)", t.Name, t.Language) }</option>
									}
								</select>
							</div>

							<div id="test-template-vars" class="flex flex-col gap-3 bg-zinc-50 p-3 rounded border border-zinc-200 hidden">
								<p class="text-xs font-bold text-zinc-600">Variáveis do Template</p>
								<div id="test-template-vars-content" class="flex flex-col gap-2"></div>
							</div>
						} else {
							<input type="hidden" name="is_template" value="false" />
							<div class="flex flex-col gap-1">
								<label for="test-body" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Corpo da Mensagem</label>
								<textarea
									name="body"
									id="test-body"
									rows="4"
									class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white w-full resize-y"
									placeholder="Mensagem de teste do PerGo!"
									required
								></textarea>
							</div>
						}

						<button type="submit" id="test-conn-submit-btn" class="btn btn-black bg-zinc-950 hover:bg-zinc-900 text-white border-none w-full font-semibold py-2 rounded-md transition h-10 flex items-center justify-center gap-2">
							<span id="test-submit-spinner" class="htmx-indicator spinner border-2 border-white border-t-transparent rounded-full w-4 h-4 animate-spin" aria-hidden="true"></span>
							<span>Enviar Mensagem de Teste</span>
						</button>
					</form>
				</div>

				<!-- Right column: Live stream -->
				<div hx-ext="ws" ws-connect="/admin/devices/test/ws" class="flex flex-col h-full border border-zinc-200 rounded-lg p-4 bg-zinc-50">
					<h4 class="text-xs font-bold text-zinc-700 uppercase tracking-wider mb-3 flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
						Atividade em Tempo Real (NATS)
					</h4>
					
					<div class="event-list flex-1 overflow-y-auto min-h-[250px] max-h-[350px] space-y-2" id="playground-events" role="log" aria-live="polite">
						<div class="text-center text-zinc-400 italic text-xs py-10" id="playground-empty">
							Nenhum evento recebido ainda. Envie um teste para ver logs em tempo real.
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
				<button class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center" onclick="this.closest('.modal-backdrop').remove()">Fechar</button>
			</div>
		</div>
	</div>

	<script>
		function showTestTemplatePreview(selectEl) {
			var container = document.getElementById('test-template-vars');
			var contentContainer = document.getElementById('test-template-vars-content');
			var langInput = document.getElementById('test-template-language');
			if (!selectEl) return;
			var selectedOption = selectEl.options ? selectEl.options[selectEl.selectedIndex] : null;

			if (!selectedOption || !selectedOption.value) {
				if (container) container.classList.add('hidden');
				if (contentContainer) contentContainer.innerHTML = '';
				if (langInput) langInput.value = '';
				return;
			}

			var lang = selectedOption.getAttribute('data-language') || 'pt_BR';
			if (langInput) langInput.value = lang;

			if (container) container.classList.remove('hidden');

			var componentsRaw = selectedOption.getAttribute('data-components');
			if (!componentsRaw) {
				if (contentContainer) {
					contentContainer.innerHTML = '<p class="text-xs text-zinc-500 bg-zinc-100 p-2 rounded border border-zinc-200">ℹ️ Este template é estático e não requer variáveis.</p>';
				}
				return;
			}

			try {
				var components = JSON.parse(componentsRaw);
				var matches = [];
				if (Array.isArray(components)) {
					for (var i = 0; i < components.length; i++) {
						var c = components[i];
						var cType = (c.type || '').toUpperCase();
						if ((cType === 'BODY' || cType === 'HEADER') && c.text) {
							var found = c.text.match(/\{\{(\d+)\}\}/g);
							if (found) {
								for (var j = 0; j < found.length; j++) {
									matches.push(found[j]);
								}
							}
						}
					}
				}

				if (matches.length === 0) {
					if (contentContainer) {
						contentContainer.innerHTML = '<p class="text-xs text-zinc-500 bg-zinc-100 p-2 rounded border border-zinc-200">ℹ️ Este template é estático e não requer variáveis.</p>';
					}
					return;
				}

				var uniqueMap = {};
				for (var k = 0; k < matches.length; k++) {
					uniqueMap[matches[k]] = true;
				}
				var uniqueParams = Object.keys(uniqueMap).sort(function(a, b) {
					var numA = parseInt(a.replace(/[{}]/g, ''));
					var numB = parseInt(b.replace(/[{}]/g, ''));
					return numA - numB;
				});

				var html = '';
				for (var idx = 0; idx < uniqueParams.length; idx++) {
					var param = uniqueParams[idx];
					var paramNum = parseInt(param.replace(/[{}]/g, ''));
					html += '<div class="flex items-center gap-2">' +
						'<span class="text-xs text-zinc-500 font-mono font-semibold w-12 text-center bg-zinc-200 py-1.5 rounded">' + param + '</span>' +
						'<input type="text" name="param_' + paramNum + '" required placeholder="Valor para ' + param + '" class="flex-1 rounded border border-zinc-300 px-2.5 py-1.5 text-xs text-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent bg-white" />' +
					'</div>';
				}
				if (contentContainer) {
					contentContainer.innerHTML = html;
				}
			} catch (e) {
				console.error("Failed to parse template components:", e);
				if (contentContainer) {
					contentContainer.innerHTML = '<p class="text-xs text-zinc-500 bg-zinc-100 p-2 rounded border border-zinc-200">ℹ️ Este template é estático e não requer variáveis.</p>';
				}
			}
		}
	</script>
}

// TestEventRow renders a single event card for the WS feed.
templ TestEventRow(eventType string, badgeClass string, title string, timeStr string, details string) {
	<div id="playground-empty" hx-swap-oob="delete"></div>
	<div id="playground-events" hx-swap-oob="afterbegin">
		<div class={ "p-3 rounded-md border-l-4 text-xs font-mono mb-2 shadow-sm border-zinc-300 bg-white",
			templ.KV("border-blue-500 bg-blue-50/30", eventType == "outbound"),
			templ.KV("border-emerald-500 bg-emerald-50/30", eventType == "inbound"),
			templ.KV("border-purple-500 bg-purple-50/30", eventType == "webhook") }>
			<div class="flex justify-between items-center mb-1">
				<span class="font-bold uppercase tracking-wider text-[10px] text-zinc-500">{ eventType }</span>
				<span class="text-zinc-400 text-[10px]">{ timeStr }</span>
			</div>
			<strong class="text-zinc-900 block mb-1">{ title }</strong>
			<pre class="bg-zinc-950 text-zinc-200 p-2 rounded text-[10px] overflow-x-auto whitespace-pre-wrap max-h-32">{ details }</pre>
		</div>
	</div>
}

// FlowKeyModal renders a modal displaying the Meta Flows 2048-bit RSA public key with a copy button.
templ FlowKeyModal(conn *repository.Connection, publicKeyPEM string) {
	<div class="modal-backdrop" role="presentation" onclick="this.closest('.modal-backdrop').remove()" onkeydown="if(event.key === 'Escape') this.closest('.modal-backdrop').remove()" tabindex="0">
		<div class="custom-modal w-full max-w-lg" role="dialog" aria-modal="true" aria-labelledby="flow-key-modal-title" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4 flex items-center justify-between">
				<div>
					<h3 id="flow-key-modal-title" class="text-lg font-bold text-zinc-900">Meta Flows: Chave Pública</h3>
					<p class="text-xs text-zinc-500 font-mono mt-0.5">{ conn.Name } ({ conn.SenderIdentity })</p>
				</div>
				<button type="button" class="text-zinc-400 hover:text-zinc-600 text-lg font-bold p-1 leading-none" onclick="this.closest('.modal-backdrop').remove()">&times;</button>
			</div>
			<div class="modal-body space-y-4">
				<div class="rounded-md bg-blue-50 border border-blue-200 p-3 text-xs text-blue-800 space-y-1">
					<p class="font-semibold">Como usar no Meta Flow Builder:</p>
					<p>Copie a chave pública abaixo e cole no seu WhatsApp Flow (no Meta Business Manager ou Flow Builder em <strong>Flow Settings &gt; Endpoint encryption</strong>) para registrar este endpoint.</p>
				</div>

				<div class="flex flex-col gap-1.5">
					<div class="flex items-center justify-between">
						<label for="flow-pub-key-textarea" class="text-xs font-semibold text-zinc-600 uppercase tracking-wider">Chave Pública RSA (2048 bits PEM)</label>
						<button
							type="button"
							id="copy-flow-key-btn"
							class="text-xs font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1 cursor-pointer"
							onclick="
								const textarea = document.getElementById('flow-pub-key-textarea');
								if (textarea) {
									navigator.clipboard.writeText(textarea.value);
									this.innerText = '✓ Copiado!';
									setTimeout(() => this.innerText = 'Copiar Chave', 2000);
								}
							"
						>
							Copiar Chave
						</button>
					</div>
					<textarea
						id="flow-pub-key-textarea"
						readonly
						rows="8"
						class="form-input border border-zinc-300 rounded-md p-2.5 text-xs font-mono bg-zinc-50 text-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent w-full select-all"
					>{ publicKeyPEM }</textarea>
				</div>
			</div>
			<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
				<button
					type="button"
					class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center"
					onclick="this.closest('.modal-backdrop').remove()"
				>
					Fechar
				</button>
				<button
					type="button"
					class="btn btn-black bg-zinc-950 hover:bg-zinc-900 text-white border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center gap-1.5"
					onclick="
						const textarea = document.getElementById('flow-pub-key-textarea');
						if (textarea) {
							navigator.clipboard.writeText(textarea.value);
							this.innerText = '✓ Copiado com Sucesso!';
							setTimeout(() => this.innerText = 'Copiar e Fechar', 2000);
						}
					"
				>
					Copiar e Fechar
				</button>
			</div>
		</div>
	</div>
}

