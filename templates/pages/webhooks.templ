package pages

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/pablojhp.pergo/internal/repository"
	"github.com/pablojhp.pergo/templates/layout"
)

templ WebhooksPage(workspaces []repository.Workspace, dlqItems []*repository.WebhookDLQ) {
	@layout.Base("Webhooks & DLQ", WebhooksContent(workspaces, dlqItems))
}

templ WebhooksContent(workspaces []repository.Workspace, dlqItems []*repository.WebhookDLQ) {
	<div class="border-b border-zinc-200 pb-5 mb-8 flex justify-between items-end">
		<div>
			<h1 class="text-2xl font-bold tracking-tight text-zinc-900">Webhooks & DLQ</h1>
			<p class="text-zinc-500 text-sm mt-1">Acompanhe falhas de entrega de webhooks de entrada e reenvios na Dead Letter Queue.</p>
		</div>
	</div>

	<div class="bg-white border border-zinc-200 rounded-lg p-6 shadow-sm mb-8">
		<h2 class="text-lg font-semibold text-zinc-900 mb-4">Workspaces Webhooks Config</h2>
		<div class="overflow-x-auto border border-zinc-200 rounded-lg shadow-sm">
			<table class="table min-w-full divide-y divide-zinc-200">
				<thead class="bg-zinc-50 text-zinc-500 text-xs font-semibold uppercase tracking-wider text-left border-b border-zinc-200">
					<tr>
						<th class="px-6 py-3">Workspace</th>
						<th class="px-6 py-3 text-right">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-200 text-sm text-zinc-700 bg-white">
					for _, ws := range workspaces {
						<tr class="hover:bg-zinc-50/50 transition-colors">
							<td class="px-6 py-4 font-semibold text-zinc-900">{ ws.Name }</td>
							<td class="px-6 py-4 text-right">
								<a href={ templ.SafeURL(fmt.Sprintf("/admin/workspaces/%s/webhooks", ws.ID)) } class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-xs font-semibold px-3 py-1.5 rounded">Configure</a>
							</td>
						</tr>
					}
					if len(workspaces) == 0 {
						<tr>
							<td colspan="2" class="px-6 py-12 text-center text-zinc-400">No workspaces found.</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<div class="bg-white border border-zinc-200 rounded-lg p-6 shadow-sm mb-6">
		<h2 class="text-lg font-semibold text-zinc-900 mb-4">Dead-Letter Queue (DLQ)</h2>
		@DLQTable(dlqItems, true)
	</div>
}

templ WorkspaceWebhooksPage(ws repository.Workspace, subs []*repository.WebhookSubscription, dlqItems []*repository.WebhookDLQ) {
	@layout.Base(fmt.Sprintf("%s - Webhooks", ws.Name), WorkspaceWebhooksContent(ws, subs, dlqItems))
}

templ WorkspaceWebhooksContent(ws repository.Workspace, subs []*repository.WebhookSubscription, dlqItems []*repository.WebhookDLQ) {
	<div class="border-b border-zinc-200 pb-5 mb-8 flex justify-between items-end">
		<div>
			<h1 class="text-2xl font-bold tracking-tight text-zinc-900">Webhooks: { ws.Name }</h1>
			<p class="text-zinc-500 text-sm mt-1">Configure múltiplos destinos de webhook, filtre eventos de domínio e gerencie assinaturas HMAC-SHA256.</p>
		</div>
		<div class="flex gap-2">
			<button
				class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer"
				hx-get={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/new", ws.ID) }
				hx-target="#modal-container"
			>
				+ Add Endpoint
			</button>
			<a href={ templ.SafeURL(fmt.Sprintf("/admin/workspaces/%s", ws.ID)) } class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center">Back to Workspace</a>
		</div>
	</div>

	<div class="bg-white border border-zinc-200 rounded-lg p-6 shadow-sm mb-8">
		<div class="flex justify-between items-center mb-4">
			<div>
				<h2 class="text-lg font-semibold text-zinc-900 font-bold">Active Subscriptions</h2>
				<p class="text-xs text-zinc-500 mt-0.5">Webhook payloads are signed with HMAC-SHA256 in the <code class="font-mono bg-zinc-100 px-1 py-0.5 rounded text-zinc-800">X-PerGo-Signature</code> header.</p>
			</div>
			<div class="text-xs font-medium text-zinc-500">
				{ fmt.Sprintf("%d endpoints configured", len(subs)) }
			</div>
		</div>

		<div class="overflow-x-auto border border-zinc-200 rounded-lg shadow-sm">
			<table class="table min-w-full divide-y divide-zinc-200">
				<thead class="bg-zinc-50 text-zinc-500 text-xs font-semibold uppercase tracking-wider text-left border-b border-zinc-200">
					<tr>
						<th class="px-6 py-3">Webhook URL</th>
						<th class="px-6 py-3">Event Filters</th>
						<th class="px-6 py-3">Status</th>
						<th class="px-6 py-3">Connectivity</th>
						<th class="px-6 py-3 text-right">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-200 text-sm text-zinc-700 bg-white">
					for _, sub := range subs {
						<tr id={ fmt.Sprintf("sub-row-%s", sub.ID) } class="hover:bg-zinc-50/50 transition-colors">
							<td class="px-6 py-4 font-mono text-xs font-semibold text-zinc-900 max-w-sm truncate" title={ sub.URL }>{ sub.URL }</td>
							<td class="px-6 py-4">
								<div class="flex flex-wrap gap-1">
									for _, evt := range sub.EventTypes {
										@EventBadge(evt)
									}
								</div>
							</td>
							<td class="px-6 py-4">
								if sub.Active {
									<span class="badge badge-sm bg-emerald-50 text-emerald-700 border-emerald-200 px-2 py-0.5 text-xs font-semibold">Active</span>
								} else {
									<span class="badge badge-sm bg-zinc-100 text-zinc-500 border-zinc-200 px-2 py-0.5 text-xs font-semibold">Inactive</span>
								}
							</td>
							<td class="px-6 py-4">
								<div id={ fmt.Sprintf("ping-status-%s", sub.ID) } class="inline-flex items-center">
									<span class="text-xs text-zinc-400 italic">Not tested</span>
								</div>
							</td>
							<td class="px-6 py-4 text-right">
								<div class="inline-flex gap-1.5 items-center">
									<button
										class="btn btn-ghost hover:bg-emerald-50 text-emerald-700 btn-xs font-semibold px-2 py-1 rounded cursor-pointer transition"
										hx-post={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/ping", ws.ID, sub.ID) }
										hx-target={ fmt.Sprintf("#ping-status-%s", sub.ID) }
										hx-swap="innerHTML"
										title="Send simulated ping payload to verify connectivity"
									>
										Test Ping
									</button>
									<button
										class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold px-2 py-1 rounded cursor-pointer transition"
										hx-get={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/test-form", ws.ID, sub.ID) }
										hx-target="#modal-container"
										title="Simulate custom webhook payload"
									>
										Simulate
									</button>
									<button
										class="btn btn-ghost hover:bg-amber-50 text-amber-700 btn-xs font-semibold px-2 py-1 rounded cursor-pointer transition"
										hx-get={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/rotate-form", ws.ID, sub.ID) }
										hx-target="#modal-container"
										title="Rotate HMAC signing secret"
									>
										Rotate Secret
									</button>
									<button
										class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold px-2 py-1 rounded cursor-pointer transition"
										hx-get={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/edit", ws.ID, sub.ID) }
										hx-target="#modal-container"
										title="Edit endpoint parameters"
									>
										Edit
									</button>
									<button
										class="btn btn-ghost hover:bg-rose-50 text-rose-600 btn-xs font-semibold px-2 py-1 rounded cursor-pointer transition"
										hx-delete={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s", ws.ID, sub.ID) }
										hx-confirm="Are you sure you want to permanently delete this webhook subscription?"
										hx-target={ fmt.Sprintf("#sub-row-%s", sub.ID) }
										hx-swap="delete"
										title="Delete endpoint"
									>
										Delete
									</button>
								</div>
							</td>
						</tr>
					}
					if len(subs) == 0 {
						<tr>
							<td colspan="5" class="px-6 py-12 text-center text-zinc-400">
								<div class="font-semibold mb-1">No endpoints configured</div>
								<div class="text-xs text-zinc-400">Click "+ Add Endpoint" to register a new webhook destination.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<div class="bg-white border border-zinc-200 rounded-lg p-6 shadow-sm mb-6">
		<h2 class="text-lg font-semibold text-zinc-900 mb-4">Workspace Dead-Letter Queue (DLQ)</h2>
		@DLQTable(dlqItems, false)
	</div>

	<div id="modal-container"></div>
}

templ EventBadge(evt string) {
	switch evt {
		case "*":
			<span class="badge badge-sm bg-zinc-100 text-zinc-800 border-zinc-200 px-2 py-0.5 text-xs font-semibold">all (*)</span>
		case "connection.status":
			<span class="badge badge-sm bg-purple-50 text-purple-700 border-purple-200 px-2 py-0.5 text-xs font-semibold">connection.status</span>
		case "message.received":
			<span class="badge badge-sm bg-blue-50 text-blue-700 border-blue-200 px-2 py-0.5 text-xs font-semibold">message.received</span>
		case "message.delivered":
			<span class="badge badge-sm bg-cyan-50 text-cyan-700 border-cyan-200 px-2 py-0.5 text-xs font-semibold">message.delivered</span>
		case "message.read":
			<span class="badge badge-sm bg-teal-50 text-teal-700 border-teal-200 px-2 py-0.5 text-xs font-semibold">message.read</span>
		case "message.failed":
			<span class="badge badge-sm bg-rose-50 text-rose-700 border-rose-200 px-2 py-0.5 text-xs font-semibold">message.failed</span>
		case "message.sent":
			<span class="badge badge-sm bg-amber-50 text-amber-700 border-amber-200 px-2 py-0.5 text-xs font-semibold">message.sent</span>
		default:
			<span class="badge badge-sm bg-zinc-100 text-zinc-700 border-zinc-200 px-2 py-0.5 text-xs font-semibold">{ evt }</span>
	}
}

templ PingStatusBadge(statusCode int, latencyMs int64, errMessage string) {
	if statusCode >= 200 && statusCode < 300 {
		<span class="badge badge-sm bg-emerald-50 text-emerald-700 border-emerald-200 px-2 py-0.5 text-xs font-semibold inline-flex items-center gap-1">
			<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
			{ fmt.Sprintf("%d OK (%dms)", statusCode, latencyMs) }
		</span>
	} else if statusCode > 0 {
		<span class="badge badge-sm bg-rose-50 text-rose-700 border-rose-200 px-2 py-0.5 text-xs font-semibold inline-flex items-center gap-1" title={ errMessage }>
			<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
			{ fmt.Sprintf("%d (%dms)", statusCode, latencyMs) }
		</span>
	} else {
		<span class="badge badge-sm bg-rose-50 text-rose-700 border-rose-200 px-2 py-0.5 text-xs font-semibold inline-flex items-center gap-1" title={ errMessage }>
			<span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
			{ fmt.Sprintf("Error (%dms)", latencyMs) }
		</span>
	}
}

templ DLQTable(items []*repository.WebhookDLQ, showWorkspace bool) {
	<div id="dlq-table-container">
		<div class="overflow-x-auto border border-zinc-200 rounded-lg shadow-sm">
			<table class="table min-w-full divide-y divide-zinc-200">
				<thead class="bg-zinc-50 text-zinc-500 text-xs font-semibold uppercase tracking-wider text-left border-b border-zinc-200">
					<tr>
						if showWorkspace {
							<th class="px-6 py-3">Workspace ID</th>
						}
						<th class="px-6 py-3">Endpoint URL</th>
						<th class="px-6 py-3">Trace ID</th>
						<th class="px-6 py-3">Message ID</th>
						<th class="px-6 py-3">Event</th>
						<th class="px-6 py-3">Attempts</th>
						<th class="px-6 py-3">Last Attempt</th>
						<th class="px-6 py-3 text-right">Actions</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-zinc-200 text-sm text-zinc-700 bg-white">
					for _, item := range items {
						<tr id={ fmt.Sprintf("dlq-row-%s", item.ID) } class="hover:bg-zinc-50/50 transition-colors">
							if showWorkspace {
								<td class="px-6 py-4 text-xs font-mono text-zinc-500">{ item.WorkspaceID.String()[:8] }</td>
							}
							<td class="px-6 py-4 text-xs font-mono text-zinc-500 max-w-xs truncate">{ item.WebhookURL }</td>
							<td class="px-6 py-4 text-xs font-mono text-zinc-500"><code>{ item.TraceID }</code></td>
							<td class="px-6 py-4 text-xs font-mono text-zinc-500"><code>{ item.MessageID }</code></td>
							<td class="px-6 py-4">
								@EventBadge(item.EventType)
							</td>
							<td class="px-6 py-4 text-xs font-mono text-zinc-500">{ fmt.Sprintf("%d", item.Attempts) }</td>
							<td class="px-6 py-4 text-xs font-mono text-zinc-500">{ item.LastAttemptAt.Format("02/01/2006 15:04:05") }</td>
							<td class="px-6 py-4 text-right">
								<div class="inline-flex gap-2">
									<button
										class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 btn-xs font-semibold cursor-pointer"
										hx-get={ fmt.Sprintf("/admin/webhooks/dlq/%s/details", item.ID) }
										hx-target="body"
										hx-swap="beforeend"
									>
										Details
									</button>
									<button
										class="btn btn-ghost hover:bg-emerald-50 text-emerald-600 btn-xs font-semibold cursor-pointer"
										hx-post={ fmt.Sprintf("/admin/webhooks/dlq/%s/retry", item.ID) }
										hx-target={ fmt.Sprintf("#dlq-row-%s", item.ID) }
										hx-swap="outerHTML"
									>
										Retry
									</button>
									<button
										class="btn btn-ghost hover:bg-rose-50 text-rose-600 btn-xs font-semibold cursor-pointer"
										hx-delete={ fmt.Sprintf("/admin/webhooks/dlq/%s", item.ID) }
										hx-confirm="Delete Webhook Log: Are you sure you want to permanently delete this dead-lettered webhook log? This action cannot be undone."
										hx-target={ fmt.Sprintf("#dlq-row-%s", item.ID) }
										hx-swap="delete"
									>
										Delete
									</button>
								</div>
							</td>
						</tr>
					}
					if len(items) == 0 {
						<tr>
							<td colspan={ fmt.Sprintf("%d", map[bool]int{true: 8, false: 7}[showWorkspace]) } class="px-6 py-12 text-center text-zinc-400">
								<div class="font-semibold mb-1">No dead-lettered webhooks</div>
								<div class="text-xs text-zinc-400">Webhook delivery is running smoothly. Any permanently failed deliveries will appear here.</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ DLQDetailModal(item *repository.WebhookDLQ) {
	<div class="modal-backdrop" onclick="this.closest('.modal-backdrop').remove()">
		<div class="custom-modal w-full max-w-2xl" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4">
				<h3 class="text-lg font-bold text-zinc-900">Dead-Letter Log Details</h3>
			</div>
			
			<div class="modal-body space-y-4">
				<div class="grid grid-cols-2 gap-4 text-xs">
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">ID</span>
						<span class="font-mono text-zinc-950 font-medium">{ item.ID.String() }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Workspace ID</span>
						<span class="font-mono text-zinc-950 font-medium">{ item.WorkspaceID.String() }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Trace ID</span>
						<span class="font-mono text-zinc-950 font-medium">{ item.TraceID }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Message ID</span>
						<span class="font-mono text-zinc-950 font-medium">{ item.MessageID }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Event Type</span>
						<span class="mt-0.5 block">
							@EventBadge(item.EventType)
						</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Webhook URL</span>
						<span class="font-mono text-zinc-950 font-medium truncate block max-w-xs">{ item.WebhookURL }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Attempts</span>
						<span class="text-zinc-950 font-medium">{ fmt.Sprintf("%d", item.Attempts) }</span>
					</div>
					<div>
						<span class="block text-zinc-400 font-semibold uppercase">Last Attempt</span>
						<span class="text-zinc-950 font-medium">{ item.LastAttemptAt.Format("02/01/2006 15:04:05") }</span>
					</div>
				</div>

				if item.FailureReason != nil {
					<div>
						<span class="block text-xs text-zinc-400 font-semibold uppercase mb-1">Failure Reason</span>
						<div class="alert bg-rose-50 text-rose-800 border border-rose-200 rounded p-3 font-mono text-xs break-all leading-relaxed">
							{ *item.FailureReason }
						</div>
					</div>
				}

				<div>
					<span class="block text-xs text-zinc-400 font-semibold uppercase mb-1">Payload JSON</span>
					<pre class="bg-zinc-950 text-emerald-400 p-4 rounded-lg text-xs leading-relaxed overflow-x-auto max-h-60 select-all font-mono">
						<code>{ string(item.Payload) }</code>
					</pre>
				</div>
			</div>

			<div class="modal-footer flex justify-end border-t pt-4 mt-6">
				<button 
					type="button" 
					class="btn btn-ghost hover:bg-zinc-100 text-zinc-700 px-4 py-2 rounded-lg text-xs font-semibold cursor-pointer"
					onclick="this.closest('.modal-backdrop').remove()"
				>
					Close
				</button>
			</div>
		</div>
	</div>
}

templ DLQBadgeFragment(count int) {
	<span id="sidebar-dlq-badge" class={ "badge", templ.KV("badge-danger", count > 0), templ.KV("badge-secondary", count == 0) }>
		if count > 0 {
			{ fmt.Sprintf("%d", count) }
		} else {
			0
		}
	</span>
}

templ SubscriptionFormModal(wsID uuid.UUID, sub *repository.WebhookSubscription) {
	<div class="modal-backdrop" onclick="this.closest('.modal-backdrop').remove()">
		<div class="custom-modal w-full max-w-lg" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4">
				<h3 class="text-lg font-bold text-zinc-900">
					if sub != nil {
						Edit Webhook Endpoint
					} else {
						Add Webhook Endpoint
					}
				</h3>
			</div>
			<form
				if sub != nil {
					hx-post={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s", wsID, sub.ID) }
				} else {
					hx-post={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions", wsID) }
				}
				hx-target="#modal-container"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<div class="flex flex-col gap-1">
					<label for="url" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Webhook Destination URL</label>
					if sub != nil {
						<input type="url" id="url" name="url" value={ sub.URL } required class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono" placeholder="https://yourdomain.com/webhooks"/>
					} else {
						<input type="url" id="url" name="url" required class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono" placeholder="https://yourdomain.com/webhooks"/>
					}
				</div>

				<div class="flex flex-col gap-1">
					<label for="secret" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">
						if sub != nil {
							HMAC Signing Secret (leave as ******** to keep current)
						} else {
							HMAC Signing Secret (optional — auto-generated if blank)
						}
					</label>
					if sub != nil {
						<input type="password" id="secret" name="secret" value="********" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono" placeholder="Enter signing secret"/>
					} else {
						<input type="password" id="secret" name="secret" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono" placeholder="Leave empty to auto-generate a secure 64-char hex secret"/>
					}
					<small class="text-xs text-zinc-400 block mt-0.5">
						Used to compute HMAC-SHA256 signatures in the <code>X-PerGo-Signature</code> header.
					</small>
				</div>

				<div class="flex flex-col gap-1">
					<label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-1">Event Subscriptions</label>
					<div class="grid grid-cols-2 gap-2 text-sm border border-zinc-200 rounded-lg p-3 bg-zinc-50">
						@checkboxHelper("*", "All Events (*)", sub)
						@checkboxHelper("connection.status", "connection.status", sub)
						@checkboxHelper("message.received", "message.received", sub)
						@checkboxHelper("message.delivered", "message.delivered", sub)
						@checkboxHelper("message.read", "message.read", sub)
						@checkboxHelper("message.failed", "message.failed", sub)
						@checkboxHelper("message.sent", "message.sent", sub)
					</div>
				</div>

				<div class="flex items-center gap-2 pt-1">
					if sub == nil || sub.Active {
						<input type="checkbox" id="active" name="active" value="true" checked class="rounded border-zinc-300 text-zinc-950 focus:ring-zinc-950 h-4 w-4 bg-white"/>
					} else {
						<input type="checkbox" id="active" name="active" value="true" class="rounded border-zinc-300 text-zinc-950 focus:ring-zinc-950 h-4 w-4 bg-white"/>
					}
					<label for="active" class="text-sm font-semibold text-zinc-700">Active (Deliver events to this endpoint)</label>
				</div>

				<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
					<button type="button" class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer" onclick="this.closest('.modal-backdrop').remove()">Cancel</button>
					<button type="submit" class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer">
						if sub != nil {
							Save Changes
						} else {
							Create Endpoint
						}
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ WebhookSecretRevealedModal(wsID uuid.UUID, subURL string, secretPlaintext string, isRotation bool) {
	<div class="modal-backdrop" onclick="this.closest('.modal-backdrop').remove(); window.location.reload();">
		<div class="custom-modal w-full max-w-xl" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4 flex items-center gap-2">
				<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
				<h3 class="text-lg font-bold text-zinc-900">
					if isRotation {
						Webhook Secret Rotated Successfully
					} else {
						Webhook Endpoint Created Successfully
					}
				</h3>
			</div>

			<div class="modal-body space-y-4">
				<div class="alert bg-amber-50 text-amber-900 border border-amber-200 rounded-lg p-4 text-xs leading-relaxed">
					<strong class="font-bold block mb-1">Important: Save this signing secret now.</strong>
					PerGo stores credentials encrypted at rest and will <strong>never display this secret again</strong>. Store it in your receiver's environment variables.
				</div>

				<div class="text-xs">
					<span class="block text-zinc-400 font-semibold uppercase mb-1">Destination Endpoint</span>
					<div class="font-mono text-zinc-900 bg-zinc-100 px-3 py-2 rounded border border-zinc-200 break-all">{ subURL }</div>
				</div>

				<div class="space-y-1.5">
					<span class="block text-xs text-zinc-500 font-semibold uppercase tracking-wider">HMAC-SHA256 Signing Secret</span>
					<div class="flex items-center gap-2 bg-zinc-950 text-emerald-400 border border-zinc-800 rounded-lg p-3">
						<code class="text-xs font-mono select-all flex-1 break-all tracking-wide">{ secretPlaintext }</code>
						<button
							type="button"
							class="btn btn-xs bg-zinc-800 text-zinc-100 hover:bg-zinc-700 border-none font-semibold px-3 py-1.5 rounded transition cursor-pointer"
							onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent).then(() => { this.textContent = 'Copied!'; setTimeout(() => this.textContent = 'Copy Secret', 2000); })"
						>
							Copy Secret
						</button>
					</div>
				</div>

				<div class="text-xs text-zinc-500 bg-zinc-50 border border-zinc-200 rounded p-3 space-y-1">
					<div class="font-semibold text-zinc-700">Signature Verification:</div>
					<p>Every outbound webhook includes header <code class="font-mono bg-white px-1 py-0.5 rounded border border-zinc-200 text-zinc-800">X-PerGo-Signature: t=&lt;timestamp&gt;,v1=&lt;signature&gt;</code>.</p>
					<p>Validate by computing HMAC-SHA256 of <code class="font-mono bg-white px-1 py-0.5 rounded border border-zinc-200 text-zinc-800">&lt;timestamp&gt;.&lt;raw_body&gt;</code> using this secret.</p>
				</div>
			</div>

			<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
				<button
					type="button"
					class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer"
					onclick="this.closest('.modal-backdrop').remove(); window.location.reload();"
				>
					Done & Refresh List
				</button>
			</div>
		</div>
	</div>
}

templ RotateSecretModal(wsID uuid.UUID, sub *repository.WebhookSubscription) {
	<div class="modal-backdrop" onclick="this.closest('.modal-backdrop').remove()">
		<div class="custom-modal w-full max-w-lg" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4 flex items-center gap-2">
				<span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>
				<h3 class="text-lg font-bold text-zinc-900">Rotate Signing Secret</h3>
			</div>

			<form
				hx-post={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/rotate", wsID, sub.ID) }
				hx-target="#modal-container"
				hx-swap="innerHTML"
				class="space-y-4"
			>
				<div class="alert bg-amber-50 text-amber-900 border border-amber-200 rounded-lg p-4 text-xs leading-relaxed">
					<strong class="font-bold block mb-1">Warning: Rotating this secret will immediately invalidate the current secret.</strong>
					Any webhook receivers verifying the <code class="font-mono bg-amber-100/70 px-1 py-0.5 rounded text-amber-950">X-PerGo-Signature</code> header will reject payloads until updated with the new secret.
				</div>

				<div class="text-xs">
					<span class="block text-zinc-400 font-semibold uppercase mb-1">Target Endpoint</span>
					<div class="font-mono text-zinc-900 bg-zinc-100 px-3 py-2 rounded border border-zinc-200 break-all">{ sub.URL }</div>
				</div>

				<div class="flex flex-col gap-1">
					<label for="new_secret" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">New Signing Secret (optional)</label>
					<input
						type="password"
						id="new_secret"
						name="secret"
						class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono"
						placeholder="Leave blank to automatically generate a secure 64-char hex secret"
					/>
					<small class="text-xs text-zinc-400 block mt-0.5">
						If left empty, a cryptographically random 32-byte (64 hex) secret will be generated.
					</small>
				</div>

				<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
					<button type="button" class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer" onclick="this.closest('.modal-backdrop').remove()">Cancel</button>
					<button type="submit" class="btn btn-black bg-amber-600 hover:bg-amber-700 text-white border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer">Rotate Secret</button>
				</div>
			</form>
		</div>
	</div>
}

templ checkboxHelper(value string, label string, sub *repository.WebhookSubscription) {
	<label class="flex items-center gap-2 py-1 cursor-pointer">
		if sub != nil && contains(sub.EventTypes, value) {
			<input type="checkbox" name="event_types" value={ value } checked class="rounded border-zinc-300 text-zinc-950 focus:ring-zinc-950 h-4 w-4 bg-white"/>
		} else {
			<input type="checkbox" name="event_types" value={ value } class="rounded border-zinc-300 text-zinc-950 focus:ring-zinc-950 h-4 w-4 bg-white"/>
		}
		<span class="text-zinc-700 text-xs font-mono">{ label }</span>
	</label>
}

func contains(arr []string, str string) bool {
	for _, a := range arr {
		if a == str {
			return true
		}
	}
	return false
}

templ TestWebhookModal(wsID uuid.UUID, sub *repository.WebhookSubscription) {
	<div class="modal-backdrop" onclick="this.closest('.modal-backdrop').remove()">
		<div class="custom-modal w-full max-w-4xl" onclick="event.stopPropagation()">
			<div class="modal-header border-b pb-3 mb-4 flex justify-between items-center">
				<h3 class="text-lg font-bold text-zinc-900">Simulate Webhook Delivery</h3>
				<span class="text-xs font-mono text-zinc-500 bg-zinc-100 px-2 py-1 rounded max-w-xs truncate">{ sub.URL }</span>
			</div>
			
			<div class="modal-body grid grid-cols-1 md:grid-cols-2 gap-6">
				<form
					hx-post={ fmt.Sprintf("/admin/workspaces/%s/webhooks/subscriptions/%s/test", wsID, sub.ID) }
					hx-target="#test-result-container"
					hx-swap="innerHTML"
					class="space-y-4"
				>
					<div class="flex flex-col gap-1">
						<label for="test-event-type" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Event Type Simulation</label>
						<select id="test-event-type" name="event_type" required class="form-input border border-zinc-300 rounded-md px-3 py-2 text-sm bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono text-xs" onchange="updateMockPayload()">
							<option value="ping">ping (Test Connectivity)</option>
							<option value="connection.status">connection.status (Lifecycle)</option>
							<option value="message.received">message.received (Inbound)</option>
							<option value="message.delivered">message.delivered (Receipt)</option>
							<option value="message.read">message.read (Receipt)</option>
							<option value="message.failed">message.failed (Error)</option>
							<option value="message.sent">message.sent (Outbound)</option>
						</select>
					</div>

					<div class="flex flex-col gap-1">
						<label for="test-payload" class="text-xs font-semibold text-zinc-500 uppercase tracking-wider">Payload JSON Body</label>
						<textarea id="test-payload" name="payload" required rows="10" class="form-input border border-zinc-300 rounded-md px-3 py-2 text-xs bg-white w-full focus:outline-none focus:ring-2 focus:ring-zinc-950 focus:border-transparent font-mono leading-relaxed"></textarea>
					</div>

					<div class="flex justify-start">
						<button type="submit" class="btn btn-black bg-zinc-950 text-white hover:bg-zinc-900 border-none btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer">Run Simulation</button>
					</div>
				</form>

				<div class="flex flex-col h-full min-h-[300px]">
					<label class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-1">Execution Results</label>
					<div id="test-result-container" class="flex-1 bg-zinc-50 border border-zinc-200 rounded-lg p-4 font-mono text-xs overflow-auto max-h-[400px]">
						<div class="text-zinc-400 italic text-center py-12">Click "Run Simulation" to execute a signed request and see live HTTP response logs here.</div>
					</div>
				</div>
			</div>

			<div class="modal-footer pt-4 border-t border-zinc-200 flex justify-end gap-2 mt-6">
				<button class="btn btn-secondary border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-700 btn-sm font-semibold px-4 py-2 rounded-md transition h-9 flex items-center justify-center cursor-pointer" onclick="this.closest('.modal-backdrop').remove()">Close</button>
			</div>

			<script>
				(function() {
					const wsID = "{ wsID.String() }";
					const subID = "{ sub.ID.String() }";
					const mockPayloads = {
						"ping": {
							"event": "ping",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"subscription_id": subID,
							"message": "PerGo Webhook Ping Test"
						},
						"connection.status": {
							"event": "connection.status",
							"trace_id": "test-trace-conn-000",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"channel": "whatsapp",
							"status": "connected"
						},
						"message.received": {
							"event": "message.received",
							"trace_id": "test-trace-received-123",
							"message_id": "mock-msg-recv-001",
							"channel": "whatsapp",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"from": "5511999999999",
							"body": "Olá, esta é uma mensagem de teste para o webhook!"
						},
						"message.delivered": {
							"event": "message.delivered",
							"trace_id": "test-trace-deliv-456",
							"message_id": "mock-msg-deliv-002",
							"channel": "whatsapp_cloud",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"recipient": "5511999999999",
							"status": "delivered"
						},
						"message.read": {
							"event": "message.read",
							"trace_id": "test-trace-read-789",
							"message_id": "mock-msg-read-003",
							"channel": "whatsapp",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"recipient": "5511999999999",
							"status": "read"
						},
						"message.failed": {
							"event": "message.failed",
							"trace_id": "test-trace-fail-004",
							"message_id": "mock-msg-fail-004",
							"channel": "telegram",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"recipient": "5511999999997",
							"error": "Delivery timeout: remote server unavailable"
						},
						"message.sent": {
							"event": "message.sent",
							"trace_id": "test-trace-sent-005",
							"message_id": "mock-msg-sent-005",
							"channel": "whatsapp_cloud",
							"timestamp": new Date().toISOString(),
							"workspace_id": wsID,
							"recipient": "5511999999998",
							"body": "Mensagem enviada com sucesso."
						}
					};

					window.updateMockPayload = function() {
						const eventType = document.getElementById("test-event-type").value;
						const payload = mockPayloads[eventType] || mockPayloads["ping"];
						document.getElementById("test-payload").value = JSON.stringify(payload, null, 2);
					};

					// Initial update on load
					window.updateMockPayload();
				})();
			</script>
		</div>
	</div>
}

templ TestResultFragment(statusCode int, latencyMs int64, signatureHeader string, responseBody string, responseHeaders map[string][]string) {
	<div class="space-y-4">
		<div class="grid grid-cols-2 gap-2 text-xs border-b pb-3 mb-3">
			<div>
				<span class="block text-zinc-400 font-semibold uppercase">HTTP Status</span>
				if statusCode >= 200 && statusCode < 300 {
					<span class="text-emerald-600 font-bold">{ fmt.Sprintf("%d OK", statusCode) }</span>
				} else {
					<span class="text-rose-600 font-bold">{ fmt.Sprintf("%d Failed", statusCode) }</span>
				}
			</div>
			<div>
				<span class="block text-zinc-400 font-semibold uppercase">Latency</span>
				<span class="text-zinc-900 font-bold">{ fmt.Sprintf("%dms", latencyMs) }</span>
			</div>
		</div>

		<div>
			<span class="block text-[10px] text-zinc-400 font-semibold uppercase mb-1">Generated Signature Header</span>
			<div class="bg-zinc-100 p-2 rounded text-[11px] font-mono select-all text-zinc-700 break-all">{ signatureHeader }</div>
		</div>

		<div>
			<span class="block text-[10px] text-zinc-400 font-semibold uppercase mb-1">Response Headers</span>
			<div class="bg-zinc-100 p-2 rounded text-[11px] font-mono text-zinc-600 max-h-28 overflow-y-auto space-y-1">
				for k, v := range responseHeaders {
					<div><span class="text-zinc-800 font-semibold">{ k }:</span> { fmt.Sprintf("%v", v) }</div>
				}
				if len(responseHeaders) == 0 {
					<div class="text-zinc-400 italic">No headers returned</div>
				}
			</div>
		</div>

		<div>
			<span class="block text-[10px] text-zinc-400 font-semibold uppercase mb-1">Response Body (first 1000 chars)</span>
			<pre class="bg-zinc-950 text-zinc-100 p-3 rounded-lg text-[11px] leading-relaxed overflow-x-auto max-h-40 select-all font-mono">
				<code>
					if responseBody != "" {
						{ responseBody }
					} else {
						[Empty Response Body]
					}
				</code>
			</pre>
		</div>
	</div>
}
