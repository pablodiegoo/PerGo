package pages

import (
	"fmt"
	"strings"

	"github.com/pablojhp.pergo/internal/domain"
	"github.com/pablojhp.pergo/templates/layout"
)

func contactInitial(name string) string {
	runes := []rune(strings.TrimSpace(name))
	if len(runes) == 0 {
		return "?"
	}
	r := runes[0]
	if r >= 'a' && r <= 'z' {
		r -= 32
	}
	return string(r)
}

func contactChannelLabel(ch string) string {
	switch ch {
	case "whatsapp":
		return "WhatsApp Web"
	case "whatsapp_cloud":
		return "WhatsApp Cloud"
	case "telegram":
		return "Telegram"
	default:
		return ch
	}
}

// ContactsPage renders the full workspace contacts directory page inside layout.Base.
templ ContactsPage(contacts []domain.Contact, query string) {
	@layout.Base("Contatos", ContactsContent(contacts, query))
}

// ContactsContent renders the Paper-Calm contacts directory content for full-page or HTMX navigation.
templ ContactsContent(contacts []domain.Contact, query string) {
	<div class="w-full space-y-6 p-6 text-[#37352f] dark:text-[#e3e3e3]">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div>
				<h1 class="text-2xl font-bold tracking-tight text-[#37352f] dark:text-[#e3e3e3]">Contatos</h1>
				<p class="text-sm text-[#787774] dark:text-[#9b9b9b] mt-0.5">
					Diretório unificado de contatos do workspace com histórico omnichannel e atributos CRM.
				</p>
			</div>
			<div class="flex items-center gap-2">
				<a
					href="/admin/tags"
					hx-get="/admin/tags"
					hx-target="#main-content"
					hx-push-url="true"
					class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-semibold rounded-lg border border-[#e9e9e7] dark:border-[#2f2f2f] bg-white dark:bg-[#202020] hover:bg-[#f7f6f3] dark:hover:bg-[#2f2f2f] text-[#37352f] dark:text-[#e3e3e3] transition-colors"
				>
					<span>Etiquetas & Importação CSV</span>
				</a>
				<a
					href="/admin/inbox"
					hx-get="/admin/inbox"
					hx-target="#main-content"
					hx-push-url="true"
					class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-lg bg-[#0369a1] hover:bg-[#0284c7] text-white transition-colors"
				>
					<span>Ir para Inbox</span>
				</a>
			</div>
		</div>

		<!-- Search Bar -->
		<div class="bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg p-4">
			<form
				action="/admin/contacts"
				method="GET"
				hx-get="/admin/contacts"
				hx-target="#contacts-table-container"
				hx-swap="innerHTML"
				class="flex items-center gap-3"
			>
				<div class="relative flex-1">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-2.5 text-[#787774] dark:text-[#9b9b9b]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
					</svg>
					<input
						type="search"
						name="q"
						value={ query }
						placeholder="Buscar por nome, telefone, e-mail ou identidade..."
						hx-get="/admin/contacts"
						hx-trigger="keyup changed delay:300ms, search"
						hx-target="#contacts-table-container"
						hx-swap="innerHTML"
						hx-vals='{"fragment":"table"}'
						class="w-full pl-9 pr-3 py-2 text-sm border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg bg-[#fbfbfa] dark:bg-[#191919] text-[#37352f] dark:text-[#e3e3e3] placeholder-[#787774] dark:placeholder-[#9b9b9b] focus:outline-none focus:ring-1 focus:ring-[#0284c7]"
					/>
				</div>
				<button
					type="submit"
					class="px-4 py-2 text-xs font-semibold rounded-lg bg-[#0369a1] hover:bg-[#0284c7] text-white transition-colors cursor-pointer"
				>
					Buscar
				</button>
			</form>
		</div>

		<!-- Contacts Table -->
		<div id="contacts-table-container">
			@ContactsTableFragment(contacts)
		</div>
	</div>
}

// ContactsTableFragment renders the contacts table rows.
templ ContactsTableFragment(contacts []domain.Contact) {
	<div class="overflow-x-auto bg-white dark:bg-[#202020] border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg">
		<table class="min-w-full divide-y divide-[#e9e9e7] dark:divide-[#2f2f2f]">
			<thead class="bg-[#f7f6f3] dark:bg-[#191919] text-[#787774] dark:text-[#9b9b9b] text-xs font-semibold uppercase tracking-wider text-left">
				<tr>
					<th class="px-5 py-3">Contato</th>
					<th class="px-5 py-3">Canais & Identidades</th>
					<th class="px-5 py-3">Etiquetas</th>
					<th class="px-5 py-3">Criado Em</th>
					<th class="px-5 py-3 text-right">Ação</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-[#e9e9e7] dark:divide-[#2f2f2f] text-sm">
				for _, c := range contacts {
					<tr class="hover:bg-[#fbfbfa] dark:hover:bg-[#191919] transition-colors">
						<td class="px-5 py-3.5">
							<div class="flex items-center gap-3">
								<div class="h-8 w-8 rounded-full bg-[#f7f6f3] dark:bg-[#2f2f2f] border border-[#e9e9e7] dark:border-[#3f3f3f] flex items-center justify-center text-xs font-bold text-[#37352f] dark:text-[#e3e3e3] shrink-0">
									{ contactInitial(c.Name) }
								</div>
								<div class="min-w-0">
									<p class="font-semibold text-[#37352f] dark:text-[#e3e3e3] truncate">
										if strings.TrimSpace(c.Name) != "" {
											{ c.Name }
										} else {
											Contato sem nome
										}
									</p>
									if c.Email != nil && strings.TrimSpace(*c.Email) != "" {
										<p class="text-xs text-[#787774] dark:text-[#9b9b9b] truncate">{ *c.Email }</p>
									}
								</div>
							</div>
						</td>
						<td class="px-5 py-3.5">
							<div class="flex flex-wrap gap-1.5">
								for _, id := range c.Identities {
									<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs bg-[#f7f6f3] dark:bg-[#191919] border border-[#e9e9e7] dark:border-[#2f2f2f] text-[#37352f] dark:text-[#e3e3e3]">
										<span class="font-medium text-[#787774] dark:text-[#9b9b9b]">{ contactChannelLabel(id.Channel) }:</span>
										<span class="font-mono text-[11px]">{ id.SenderIdentity }</span>
									</span>
								}
								if len(c.Identities) == 0 {
									<span class="text-xs text-[#787774] dark:text-[#9b9b9b]">—</span>
								}
							</div>
						</td>
						<td class="px-5 py-3.5">
							<div class="flex flex-wrap gap-1">
								for _, tag := range c.Tags {
									<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-sky-50 dark:bg-sky-950/40 text-[#0284c7] dark:text-sky-300 border border-sky-200 dark:border-sky-800">
										{ tag }
									</span>
								}
								if len(c.Tags) == 0 {
									<span class="text-xs text-[#787774] dark:text-[#9b9b9b]">—</span>
								}
							</div>
						</td>
						<td class="px-5 py-3.5 text-xs font-mono text-[#787774] dark:text-[#9b9b9b]">
							{ c.CreatedAt.Format("02/01/2006 15:04") }
						</td>
						<td class="px-5 py-3.5 text-right">
							<a
								href={ templ.URL(fmt.Sprintf("/admin/inbox?contact=%s", c.ID.String())) }
								class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#0369a1] hover:bg-[#0284c7] text-white transition-colors"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
								</svg>
								<span>Abrir na Inbox</span>
							</a>
						</td>
					</tr>
				}
				if len(contacts) == 0 {
					<tr>
						<td colspan="5" class="px-6 py-12 text-center text-sm text-[#787774] dark:text-[#9b9b9b]">
							Nenhum contato encontrado.
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
