package components

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/pablojhp.pergo/internal/domain"
	"github.com/pablojhp.pergo/internal/i18n"
	"github.com/pablojhp.pergo/internal/repository"
)

type ReplyOption struct {
	Channel        string
	RecipientPhone string // the contact identity to send to
	SenderIdentity string // the system/bot identity to send from
	Label          string
}

// channelLabelStr returns a human-readable display name for a channel (plain string, for use in Go expressions).
func channelLabelStr(channel string) string {
	switch channel {
	case "whatsapp":
		return "WhatsApp Web"
	case "whatsapp_cloud":
		return "WhatsApp Cloud"
	case "telegram":
		return "Telegram"
	default:
		return channel
	}
}

// safeInitialStr returns the first rune of s, uppercase, as a string.
func safeInitialStr(s string) string {
	runes := []rune(s)
	if len(runes) == 0 {
		return "?"
	}
	r := runes[0]
	if r >= 'a' && r <= 'z' {
		r -= 32
	}
	return string(r)
}

// getLastMessageID returns the last message's ID as a string, or empty if no messages.
func getLastMessageID(messages []repository.ThreadMessage) string {
	if len(messages) == 0 {
		return ""
	}
	return messages[len(messages)-1].ID.String()
}

// ChatPanel renders the full chat thread view (middle column) plus contact CRM metadata (right column).
templ ChatPanel(contact *domain.Contact, chat *domain.Chat, replyOptions []ReplyOption, messages []repository.ThreadMessage, isWabaBlocked bool, extra ...any) {
	{{
		var members []repository.WorkspaceMember
		for _, x := range extra {
			if m, ok := x.([]repository.WorkspaceMember); ok {
				members = m
			}
		}
	}}
	<div class="chat-main-container flex h-full w-full overflow-hidden text-[#37352f] dark:text-[#e3e3e3]" id="chat-panel-inner">
		<!-- Middle column: Conversation Thread -->
		<div class="chat-thread flex-1 flex flex-col h-full min-w-0 bg-[#fbfbfa] dark:bg-[#191919]">
			<!-- Header -->
			<div class="chat-thread-header flex items-center justify-between px-4 py-3 border-b border-[#e9e9e7] dark:border-[#2f2f2f] bg-white dark:bg-[#202020] flex-shrink-0">
				<div class="flex items-center gap-3 min-w-0">
					<div class="h-9 w-9 rounded-full bg-gradient-to-br from-indigo-400 to-purple-500 flex items-center justify-center text-white font-semibold text-sm select-none shrink-0">
						{ safeInitialStr(contact.Name) }
					</div>
					<div class="min-w-0">
						<div class="flex items-center gap-2">
							<p class="font-semibold text-sm text-[#37352f] dark:text-[#e3e3e3] truncate">{ contact.Name }</p>
							@BotStatusBadge(contact)
					if chat != nil {
						@AIStatusBadge(chat)
					}
						</div>
						<div class="flex items-center gap-1.5 mt-0.5 truncate">
							for i, identity := range contact.Identities {
								if i > 0 {
									<span class="text-[#e9e9e7] dark:text-[#2f2f2f] text-[10px]">|</span>
								}
								<span class="text-[10px] text-[#787774] dark:text-[#9b9b9b]">{ channelLabelStr(identity.Channel) }: { identity.SenderIdentity }</span>
							}
						</div>
					</div>
				</div>

				<!-- Header Triage & Presence Controls -->
				<div class="flex items-center gap-2 shrink-0">
					<!-- Active Viewers & Collision Alert -->
					<div id="chat-presence-container" class="flex items-center gap-1.5">
						<div id="chat-presence-viewers" class="flex items-center -space-x-1.5 overflow-hidden"></div>
						<div id="chat-collision-alert" class="hidden items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-100 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-700/60 shadow-xs">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 animate-pulse text-amber-600 dark:text-amber-400" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
							</svg>
							<span id="chat-collision-text">Outro operador na conversa</span>
						</div>
					</div>

					<!-- Resolve / Reopen Button -->
					if chat != nil && chat.Status == "closed" {
						<button
							type="button"
							hx-post={ fmt.Sprintf("/admin/inbox/status?contact_id=%s&status=open", contact.ID.String()) }
							hx-target="#chat-panel"
							class="inline-flex items-center gap-1 px-2.5 py-1.5 border border-[#e9e9e7] dark:border-[#2f2f2f] text-xs font-semibold rounded-lg text-[#0284c7] bg-white dark:bg-[#202020] hover:bg-sky-50 dark:hover:bg-sky-950/40 shadow-none transition-colors cursor-pointer"
							title="Reabrir conversa"
						>
							↺ Reabrir
						</button>
					} else {
						<button
							type="button"
							hx-post={ fmt.Sprintf("/admin/inbox/status?contact_id=%s&status=closed", contact.ID.String()) }
							hx-target="#chat-panel"
							class="inline-flex items-center gap-1 px-2.5 py-1.5 border border-emerald-300 dark:border-emerald-800 text-xs font-semibold rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 transition-colors cursor-pointer shadow-none"
							title="Resolver / Fechar conversa"
						>
							✓ Resolver
						</button>
					}

					<!-- Merging UI Dropdown inside Chat Panel Header -->
					<div class="relative inline-block text-left" id="merge-dropdown-container">
						<button 
							type="button" 
							class="inline-flex items-center gap-1.5 px-2.5 py-1.5 border border-[#e9e9e7] dark:border-[#2f2f2f] text-xs font-semibold rounded-lg text-[#37352f] dark:text-[#e3e3e3] bg-white dark:bg-[#202020] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 shadow-none transition-colors cursor-pointer"
							onclick="document.getElementById('merge-menu').classList.toggle('hidden')"
						>
							{ i18n.T(ctx, "inbox.merge_contact") }
						</button>

						<div 
							id="merge-menu" 
							class="hidden origin-top-right absolute right-0 mt-2 w-72 rounded-lg shadow-lg bg-white dark:bg-[#202020] ring-1 ring-black/5 focus:outline-none z-50 p-3 border border-[#e9e9e7] dark:border-[#2f2f2f]"
						>
							<p class="text-xs font-semibold text-[#787774] dark:text-[#9b9b9b] mb-2">{ i18n.T(ctx, "inbox.merge_with_other") }</p>
							<input 
								type="text" 
								name="q" 
								placeholder={ i18n.T(ctx, "inbox.search_name_or_phone") } 
								class="w-full px-2 py-1.5 text-xs border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg bg-[#fbfbfa] dark:bg-[#191919] text-[#37352f] dark:text-[#e3e3e3] focus:outline-none focus:ring-1 focus:ring-[#0284c7]"
								hx-get={ fmt.Sprintf("/admin/contacts/search?exclude_id=%s", contact.ID.String()) }
								hx-trigger="keyup changed delay:300ms"
								hx-target="#merge-results"
							/>
							<div id="merge-results" class="mt-2 max-h-48 overflow-y-auto flex flex-col gap-1"></div>
						</div>
					</div>
				</div>
			</div>

			<!-- WABA 24h Block Warning Banner -->
			if isWabaBlocked {
				<div class="px-4 py-2 bg-amber-50 dark:bg-amber-950/30 border-b border-amber-200 dark:border-amber-800/50 text-amber-800 dark:text-amber-300 text-xs font-semibold flex items-center gap-1.5 flex-shrink-0">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
					</svg>
					<span>{ i18n.T(ctx, "inbox.waba_24h_window_closed") }</span>
				</div>
			}

			<!-- Message viewport -->
			<div
				id="chat-messages"
				class="chat-messages flex-1 overflow-y-auto px-4 py-3 flex flex-col gap-2 bg-[#fbfbfa] dark:bg-[#191919]"
			>
				if len(messages) == 0 {
					<div class="text-center text-[#787774] dark:text-[#9b9b9b] text-sm py-8 select-none">{ i18n.T(ctx, "inbox.no_messages") }</div>
				}
				for _, m := range messages {
					@MessageBubble(m)
				}
			</div>
			<!-- Invisible polling sentinel — appends new bubbles every 3s after last message ID -->
			<div
				id="chat-poll-anchor"
				hx-get={ fmt.Sprintf("/admin/inbox/messages?contact_id=%s&after_id=%s", contact.ID.String(), getLastMessageID(messages)) }
				hx-target="#chat-messages"
				hx-swap="beforeend scroll:bottom"
				hx-trigger="every 3s"
				class="hidden"
			></div>
			
			<!-- Send form -->
			<div class="chat-input-area px-4 py-3 border-t border-[#e9e9e7] dark:border-[#2f2f2f] bg-white dark:bg-[#202020] flex-shrink-0">
				<form
					id="chat-send-form"
					hx-post="/admin/inbox/send"
					hx-target="#chat-send-status"
					hx-swap="innerHTML"
					hx-on::after-request="if(event.detail.successful){document.getElementById('chat-textarea').value='';document.getElementById('chat-textarea').style.height='40px';}"
				>
					@replyFormFields(replyOptions)
				</form>
			</div>
		</div>

		<!-- Right column: Contact CRM Metadata -->
		<div class="contact-crm-sidebar w-80 flex-shrink-0 border-l border-[#e9e9e7] dark:border-[#2f2f2f] bg-white dark:bg-[#202020] h-full overflow-y-auto hidden md:flex md:flex-col">
			@ContactCRMPanel(contact, chat, members)
		</div>
	</div>

	<!-- Presence and Heartbeat Client Script -->
	<script>
		(function() {
			var contactId = '{ contact.ID.String() }';
			var presenceViewers = document.getElementById('chat-presence-viewers');
			var collisionAlert = document.getElementById('chat-collision-alert');
			var collisionText = document.getElementById('chat-collision-text');
			
			function sendHeartbeat(status) {
				var formData = new FormData();
				formData.append('contact_id', contactId);
				formData.append('status', status || 'viewing');
				fetch('/admin/inbox/presence', {
					method: 'POST',
					body: formData
				}).catch(function(){});
			}

			sendHeartbeat('viewing');
			var hbInterval = setInterval(function() {
				sendHeartbeat('viewing');
			}, 8000);

			var textarea = document.getElementById('chat-textarea');
			if (textarea) {
				textarea.addEventListener('input', function() {
					sendHeartbeat('typing');
				});
			}

			var evtSource = new EventSource('/admin/inbox/presence?contact_id=' + contactId);
			evtSource.addEventListener('presence', function(e) {
				try {
					var viewers = JSON.parse(e.data);
					if (!viewers || !presenceViewers) return;
					presenceViewers.innerHTML = '';
					
					viewers.forEach(function(v) {
						var avatar = document.createElement('div');
						var isTyping = v.status === 'typing';
						avatar.className = 'h-7 w-7 rounded-full flex items-center justify-center text-[10px] font-bold text-white shadow-sm ring-2 ' +
							(isTyping ? 'bg-amber-500 ring-amber-300 animate-pulse' : 'bg-sky-600 ring-white dark:ring-zinc-800');
						avatar.title = (v.name || v.email) + ' (' + v.email + ') - ' + (isTyping ? 'digitando...' : 'visualizando');
						avatar.textContent = (v.name || v.email || '?').charAt(0).toUpperCase();
						presenceViewers.appendChild(avatar);
					});

					if (collisionAlert) {
						if (viewers.length > 1) {
							collisionAlert.classList.remove('hidden');
							collisionAlert.classList.add('flex');
							if (collisionText) {
								var names = viewers.map(function(v){ return v.name || v.email; }).join(', ');
								collisionText.textContent = viewers.length + ' operadores (' + names + ')';
							}
						} else {
							collisionAlert.classList.add('hidden');
							collisionAlert.classList.remove('flex');
						}
					}
				} catch(err) {}
			});

			window.addEventListener('beforeunload', function() {
				clearInterval(hbInterval);
				if (evtSource) evtSource.close();
			});

			var vp = document.getElementById('chat-messages');
			if (vp) { vp.scrollTop = vp.scrollHeight; }
		})();
	</script>
}

// replyFormFields renders the input fields, picker, and text area for compose form.
templ replyFormFields(replyOptions []ReplyOption) {
	{{
		var defaultContact, defaultChannel, defaultSender string
		hasWaba := false
		if len(replyOptions) > 0 {
			defaultContact = replyOptions[0].RecipientPhone
			defaultChannel = replyOptions[0].Channel
			defaultSender = replyOptions[0].SenderIdentity
		}
		for _, opt := range replyOptions {
			if opt.Channel == "whatsapp_cloud" {
				hasWaba = true
			}
		}
	}}
	<input type="hidden" id="chat-contact" name="contact" value={ defaultContact }/>
	<input type="hidden" id="chat-channel" name="channel" value={ defaultChannel }/>
	<input type="hidden" id="chat-sender" name="recipient_identity" value={ defaultSender }/>

	<div class="flex flex-col gap-2 w-full">
		if len(replyOptions) > 1 {
			<div class="flex items-center gap-2 mb-1">
				<span class="text-xs text-[#787774] dark:text-[#9b9b9b] font-medium">{ i18n.T(ctx, "inbox.reply_via") }</span>
				<select 
					id="chat-reply-picker"
					class="text-xs border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg px-2 py-1 bg-white dark:bg-[#202020] text-[#37352f] dark:text-[#e3e3e3] focus:outline-none focus:ring-1 focus:ring-[#0284c7] focus:border-transparent cursor-pointer"
					onchange="updateReplyFields(this)"
				>
					for _, opt := range replyOptions {
						<option 
							value={ opt.RecipientPhone }
							data-channel={ opt.Channel }
							data-sender={ opt.SenderIdentity }
						>
							{ opt.Label }
						</option>
					}
				</select>
			</div>
		} else if len(replyOptions) == 1 {
			<div class="text-[11px] text-[#787774] dark:text-[#9b9b9b] font-medium mb-1">
				{ i18n.T(ctx, "inbox.replying_via", "channel", channelLabelStr(replyOptions[0].Channel), "recipient", replyOptions[0].RecipientPhone) }
			</div>
		} else {
			<div class="text-[11px] text-rose-500 font-medium mb-1">
				{ i18n.T(ctx, "inbox.no_active_channel") }
			</div>
		}

		<div class="flex items-end gap-2">
			<!-- WABA Template button -->
			if hasWaba {
				<button
					id="chat-tmpl-btn"
					type="button"
					class="h-10 px-3 border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg text-[#37352f] dark:text-[#e3e3e3] bg-white dark:bg-[#202020] hover:bg-[#e9e9e7]/50 dark:hover:bg-[#2f2f2f]/50 text-xs font-semibold flex items-center gap-1.5 flex-shrink-0 shadow-none transition-colors cursor-pointer"
					style={ fmt.Sprintf("display: %s;", map[bool]string{true: "flex", false: "none"}[defaultChannel == "whatsapp_cloud"]) }
					hx-get={ fmt.Sprintf("/admin/inbox/new-message-modal?type=template_only&from=%s&channel=whatsapp_cloud&to=%s", defaultContact, defaultSender) }
					hx-target="#modal-container"
					hx-swap="innerHTML"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#0284c7]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span>{ i18n.T(ctx, "inbox.templates") }</span>
				</button>
			}

			<textarea
				id="chat-textarea"
				name="body"
				placeholder={ i18n.T(ctx, "inbox.type_message_placeholder") }
				rows="1"
				class="flex-1 resize-none rounded-lg border border-[#e9e9e7] dark:border-[#2f2f2f] bg-[#fbfbfa] dark:bg-[#191919] px-3 py-2 text-sm text-[#37352f] dark:text-[#e3e3e3] placeholder-[#787774] dark:placeholder-[#9b9b9b] focus:outline-none focus:ring-2 focus:ring-[#0284c7] focus:border-transparent transition-shadow overflow-hidden disabled:opacity-50"
				style="min-height:40px;max-height:160px;"
				oninput="this.style.height='40px';this.style.height=Math.min(this.scrollHeight,160)+'px';"
				onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();if(!this.disabled && this.value.trim()){htmx.trigger(this.closest('form'),'submit');}}"
				if len(replyOptions) == 0 {
					disabled
				}
			></textarea>
			<button
				type="submit"
				class="flex-shrink-0 h-10 w-10 rounded-full bg-[#0369a1] hover:bg-[#0284c7] active:bg-[#0284c7] flex items-center justify-center text-white transition-colors shadow-none cursor-pointer disabled:opacity-50"
				aria-label={ i18n.T(ctx, "common.actions.send") }
				if len(replyOptions) == 0 {
					disabled
				}
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
				</svg>
			</button>
		</div>
		<div id="chat-send-status" class="mt-1 text-xs text-[#787774] dark:text-[#9b9b9b] min-h-[16px]"></div>
	</div>

	<script>
		function updateReplyFields(select) {
			var opt = select.options[select.selectedIndex];
			document.getElementById('chat-contact').value = opt.value;
			document.getElementById('chat-channel').value = opt.getAttribute('data-channel');
			document.getElementById('chat-sender').value = opt.getAttribute('data-sender');
			
			var tmplBtn = document.getElementById('chat-tmpl-btn');
			if (tmplBtn) {
				if (opt.getAttribute('data-channel') === 'whatsapp_cloud') {
					tmplBtn.style.display = 'flex';
					var from = opt.value;
					var to = opt.getAttribute('data-sender');
					tmplBtn.setAttribute('hx-get', '/admin/inbox/new-message-modal?type=template_only&from=' + from + '&channel=whatsapp_cloud&to=' + to);
					htmx.process(tmplBtn);
				} else {
					tmplBtn.style.display = 'none';
				}
			}
		}
	</script>
}

// ContactSearchResults renders the type-ahead search results returned by GET /admin/contacts/search
templ ContactSearchResults(results []domain.Contact, primaryID uuid.UUID) {
	for _, c := range results {
		<div 
			class="p-2 hover:bg-[#fbfbfa] dark:hover:bg-[#191919] rounded-lg cursor-pointer text-xs flex justify-between items-center border-b border-[#e9e9e7] dark:border-[#2f2f2f] last:border-b-0"
			hx-post={ fmt.Sprintf("/admin/contacts/merge?primary_id=%s&secondary_id=%s", primaryID.String(), c.ID.String()) }
			hx-confirm={ fmt.Sprintf("Tem certeza que deseja mesclar %s com este contato? Todo o histórico de conversas será unificado.", c.Name) }
			hx-target="body"
		>
			<div>
				<p class="font-medium text-[#37352f] dark:text-[#e3e3e3]">{ c.Name }</p>
				if c.Email != nil && *c.Email != "" {
					<p class="text-[#787774] dark:text-[#9b9b9b] text-[10px]">{ *c.Email }</p>
				}
			</div>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-[#787774] dark:text-[#9b9b9b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
			</svg>
		</div>
	}
	if len(results) == 0 {
		<p class="text-xs text-[#787774] dark:text-[#9b9b9b] text-center py-2">{ i18n.T(ctx, "inbox.no_contacts_found") }</p>
	}
}

templ BotStatusBadge(contact *domain.Contact) {
	<button
		id="bot-status-badge"
		hx-post={ fmt.Sprintf("/admin/contacts/%s/toggle-bot", contact.ID.String()) }
		hx-swap="outerHTML"
		class={ "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium cursor-pointer transition-colors border select-none",
			templ.KV("bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100", contact.BotActive),
			templ.KV("bg-[#fbfbfa] dark:bg-[#191919] text-[#787774] dark:text-[#9b9b9b] border-[#e9e9e7] dark:border-[#2f2f2f] hover:bg-[#e9e9e7]/50", !contact.BotActive) }
	>
		if contact.BotActive {
			<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 mr-1" aria-hidden="true"></span>
			{ i18n.T(ctx, "inbox.bot_active") }
		} else {
			<span class="h-1.5 w-1.5 rounded-full bg-zinc-400 mr-1" aria-hidden="true"></span>
			{ i18n.T(ctx, "inbox.bot_paused") }
		}
	</button>
}

templ AIStatusBadge(chat *domain.Chat) {
	if chat != nil {
		<div id="ai-status-container" class="inline-flex items-center gap-1.5">
			if chat.AIDisabled {
				<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800 select-none">
					<span class="h-1.5 w-1.5 rounded-full bg-amber-500 mr-1.5 animate-pulse" aria-hidden="true"></span>
					AI Paused (Human Takeover)
				</span>
				<button
					id="btn-resume-ai"
					hx-post={ fmt.Sprintf("/admin/inbox/chats/%s/enable-ai?enabled=true", chat.ID.String()) }
					hx-target="#ai-status-container"
					hx-swap="outerHTML"
					class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white cursor-pointer transition-colors shadow-none select-none"
				>
					Resume AI
				</button>
			} else {
				<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 select-none">
					<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 mr-1.5" aria-hidden="true"></span>
					AI Active
				</span>
			}
		</div>
	}
}

// ContactCRMPanel renders the 3rd column containing the contact profile and CRM attributes.
templ ContactCRMPanel(contact *domain.Contact, extra ...any) {
	{{
		var chat *domain.Chat
		var members []repository.WorkspaceMember
		for _, x := range extra {
			if c, ok := x.(*domain.Chat); ok {
				chat = c
			} else if m, ok := x.([]repository.WorkspaceMember); ok {
				members = m
			}
		}
	}}
	<div class="flex flex-col gap-5 p-5 text-[#37352f] dark:text-[#e3e3e3]">
		<!-- Contact Header / Avatar -->
		<div class="flex flex-col items-center text-center pb-4 border-b border-[#e9e9e7] dark:border-[#2f2f2f]">
			<div class="h-16 w-16 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xl select-none mb-3 shadow-sm">
				{ safeInitialStr(contact.Name) }
			</div>
			<h2 class="text-base font-bold text-[#37352f] dark:text-[#e3e3e3]">{ contact.Name }</h2>
			if contact.Email != nil && *contact.Email != "" {
				<p class="text-xs text-[#787774] dark:text-[#9b9b9b] mt-0.5">{ *contact.Email }</p>
			}
			<div class="mt-3">
				@BotStatusBadge(contact)
			</div>
		</div>

		<!-- Triage: Assignee Selector -->
		<div>
			<h3 class="text-xs font-semibold uppercase tracking-wider text-[#787774] dark:text-[#9b9b9b] mb-2">Responsável</h3>
			<form hx-post={ fmt.Sprintf("/admin/inbox/assign?contact_id=%s", contact.ID.String()) } hx-target="#chat-panel">
				<select
					name="email"
					onchange="htmx.trigger(this.closest('form'), 'submit')"
					class="w-full text-xs border border-[#e9e9e7] dark:border-[#2f2f2f] rounded-lg px-2.5 py-1.5 bg-[#fbfbfa] dark:bg-[#191919] text-[#37352f] dark:text-[#e3e3e3] focus:outline-none focus:ring-1 focus:ring-[#0284c7] cursor-pointer"
				>
					<option value="">Não atribuído</option>
					for _, m := range members {
						<option value={ m.Email } selected?={ chat != nil && chat.AssignedEmail != nil && *chat.AssignedEmail == m.Email }>
							{ m.Name } ({ m.Email })
						</option>
					}
				</select>
			</form>
		</div>

		<!-- Triage: Tags Management -->
		<div>
			<div class="flex items-center justify-between mb-2">
				<h3 class="text-xs font-semibold uppercase tracking-wider text-[#787774] dark:text-[#9b9b9b]">Etiquetas</h3>
				<button
					type="button"
					onclick="document.getElementById('tag-input-form').classList.toggle('hidden')"
					class="text-xs text-[#0284c7] hover:underline cursor-pointer"
				>
					+ Adicionar
				</button>
			</div>
			<form id="tag-input-form" class="hidden mb-2" hx-post={ fmt.Sprintf("/admin/inbox/tags/add?contact_id=%s", contact.ID.String()) } hx-target="#chat-panel">
				<div class="flex gap-1.5">
					<input type="text" name="tag" placeholder="Nova etiqueta..." class="flex-1 px-2 py-1 text-xs border border-[#e9e9e7] dark:border-[#2f2f2f] rounded bg-[#fbfbfa] dark:bg-[#191919] text-[#37352f] dark:text-[#e3e3e3] focus:outline-none focus:ring-1 focus:ring-[#0284c7]"/>
					<button type="submit" class="px-2 py-1 text-xs bg-[#0284c7] text-white rounded hover:bg-[#0369a1] cursor-pointer">Salvar</button>
				</div>
			</form>
			<div class="flex flex-wrap gap-1.5">
				{{
					allTags := contact.Tags
					if chat != nil && len(chat.Tags) > 0 {
						tagSet := make(map[string]bool)
						for _, t := range allTags {
							tagSet[t] = true
						}
						for _, t := range chat.Tags {
							if !tagSet[t] {
								allTags = append(allTags, t)
								tagSet[t] = true
							}
						}
					}
				}}
				for _, tag := range allTags {
					<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-sky-50 dark:bg-sky-950/40 text-[#0284c7] dark:text-sky-300 border border-sky-200 dark:border-sky-800">
						<span>{ tag }</span>
						<button
							type="button"
							hx-post={ fmt.Sprintf("/admin/inbox/tags/remove?contact_id=%s&tag=%s", contact.ID.String(), tag) }
							hx-target="#chat-panel"
							class="text-sky-400 hover:text-sky-700 dark:hover:text-white cursor-pointer ml-0.5"
							title="Remover etiqueta"
						>
							×
						</button>
					</span>
				}
				if len(allTags) == 0 {
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">Nenhuma etiqueta aplicada</p>
				}
			</div>
		</div>

		<!-- Identities / Channels -->
		<div>
			<h3 class="text-xs font-semibold uppercase tracking-wider text-[#787774] dark:text-[#9b9b9b] mb-2">Canais & Identidades</h3>
			<div class="flex flex-col gap-2">
				for _, identity := range contact.Identities {
					<div class="flex items-center justify-between p-2 rounded-lg bg-[#fbfbfa] dark:bg-[#191919] border border-[#e9e9e7] dark:border-[#2f2f2f] text-xs">
						<div class="flex items-center gap-2">
							<span class="font-medium text-[#37352f] dark:text-[#e3e3e3]">{ channelLabelStr(identity.Channel) }</span>
						</div>
						<span class="text-[#787774] dark:text-[#9b9b9b] font-mono text-[11px]">{ identity.SenderIdentity }</span>
					</div>
				}
				if len(contact.Identities) == 0 {
					<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">Nenhum canal associado</p>
				}
			</div>
		</div>

		<!-- CRM Attributes -->
		<div>
			<h3 class="text-xs font-semibold uppercase tracking-wider text-[#787774] dark:text-[#9b9b9b] mb-2">Atributos CRM</h3>
			if len(contact.Attributes) > 0 {
				<div class="flex flex-col gap-1.5">
					for k, v := range contact.Attributes {
						<div class="flex justify-between items-center text-xs p-2 rounded-lg bg-[#fbfbfa] dark:bg-[#191919] border border-[#e9e9e7] dark:border-[#2f2f2f]">
							<span class="font-medium text-[#787774] dark:text-[#9b9b9b] truncate">{ k }</span>
							<span class="font-semibold text-[#37352f] dark:text-[#e3e3e3] truncate max-w-[140px] text-right">{ v }</span>
						</div>
					}
				</div>
			} else {
				<p class="text-xs text-[#787774] dark:text-[#9b9b9b]">Nenhum atributo personalizado</p>
			}
		</div>

		<!-- Audit & Timestamps -->
		<div class="pt-3 border-t border-[#e9e9e7] dark:border-[#2f2f2f] text-[11px] text-[#787774] dark:text-[#9b9b9b] flex flex-col gap-1">
			<div class="flex justify-between">
				<span>Cadastrado em:</span>
				<span class="font-medium">{ contact.CreatedAt.Format("02/01/2006 15:04") }</span>
			</div>
			<div class="flex justify-between">
				<span>Última atualização:</span>
				<span class="font-medium">{ contact.UpdatedAt.Format("02/01/2006 15:04") }</span>
			</div>
		</div>
	</div>
}
