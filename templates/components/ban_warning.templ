package components

import "github.com/pablojhp.pergo/internal/i18n"

// BanWarning renders the WhatsApp Web unofficial API warning banner.
// Displayed prominently during QR pairing to inform operators of risks.
templ BanWarning() {
	<div class="ban-warning flex items-center gap-2 p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 text-amber-800 dark:text-amber-300 text-xs">
		<span class="ban-warning-icon inline-flex items-center">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
			</svg>
		</span>
		<span class="ban-warning-text">
			<strong>{ i18n.T(ctx, "ban_warning.title") }</strong> — { i18n.T(ctx, "ban_warning.description") }
		</span>
	</div>
}
